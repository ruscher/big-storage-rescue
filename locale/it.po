#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:22
msgid "Usage: big-storage-rescue [OPTION] [DEVICE|FOLDER]"
msgstr "Uso: big-storage-rescue [OPZIONE] [DISPOSITIVO|CARTELLA]"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:25
msgid "(none)"
msgstr "(nessuna)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:25
msgid "the application in a graphical session, the manager in a terminal"
msgstr "l'applicazione in una sessione grafica, il gestore in un terminale"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:26
msgid "the application: drives, health and file rescue"
msgstr "l'applicazione: unità, stato di salute e recupero dei file"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:27
msgid "the same application, opened on the health of the drive"
msgstr "la stessa applicazione, aperta sullo stato di salute dell'unità"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:28
msgid "the same application, opened on the recovery of files from it"
msgstr "la stessa applicazione, aperta sul recupero dei file dell'unità"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:29
msgid "drive manager and file rescue in the terminal (big-storage-rescue --cli --help)"
msgstr "gestore delle unità e recupero dei file nel terminale (big-storage-rescue --cli --help)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:30
msgid "storage overview, or details of one device (a whole disk: drive errors)"
msgstr "panoramica dell'archiviazione, o dettagli di un dispositivo (un disco intero: errori dell'unità)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:31
msgid "show what keeps a device busy"
msgstr "mostra cosa tiene occupato un dispositivo"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:32
msgid "unmount one filesystem safely"
msgstr "smonta un file system in modo sicuro"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:33
msgid "unmount every filesystem of the drive and power it off"
msgstr "smonta tutti i file system dell'unità e la spegne"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:34
msgid "with --safe-remove: unmount everything, do not power it off"
msgstr "con --safe-remove: smonta tutto, senza spegnere l'unità"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:35
msgid "offer to close the programs that keep it busy"
msgstr "propone di chiudere i programmi che la tengono occupata"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:36
msgid "do not ask before closing them or stopping services (scripts)"
msgstr "non chiede conferma prima di chiuderli o di fermare servizi (script)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:37
msgid "graphical diagnosis of one device (Dolphin menu)"
msgstr "diagnosi grafica di un dispositivo (menu di Dolphin)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:38
msgid "graphical safe removal (Dolphin menu)"
msgstr "rimozione sicura grafica (menu di Dolphin)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:39
msgid "session service: warn about read-only devices"
msgstr "servizio di sessione: avvisa dei dispositivi in sola lettura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:40
msgid "bring the copies and settings of Big-Mount 2.x over (also done on start)"
msgstr "importa le copie e le impostazioni di Big-Mount 2.x (avviene anche all'avvio)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:41
msgid "check the installation and the storage stack (for bug reports)"
msgstr "verifica l'installazione e lo stack di archiviazione (per le segnalazioni di bug)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:42
msgid "show the version and the source revision"
msgstr "mostra la versione e la revisione del sorgente"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:43
msgid "show this help"
msgstr "mostra questo aiuto"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:44
msgid "TARGET is a device (/dev/sdb1) or any folder inside a mounted device."
msgstr "TARGET è un dispositivo (/dev/sdb1) o una qualsiasi cartella all'interno di un dispositivo montato."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:45
msgid "Machine-readable output: big-storage-rescue --cli COMMAND --json"
msgstr "Output leggibile da una macchina: big-storage-rescue --cli COMANDO --json"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:123 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:849 big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:441 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:237 big-storage-rescue/usr/lib/big-storage-rescue/migrate.sh:190
msgid "big-storage-rescue: unknown option '%s' (see big-storage-rescue --help)"
msgstr "big-storage-rescue: opzione sconosciuta '%s' (vedi big-storage-rescue --help)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:141
msgid "The jobs of Big-Mount 2.x are not brought over by a dry run. To see them here, run first: big-storage-rescue --migrate-state"
msgstr "I lavori di Big-Mount 2.x non vengono importati da una simulazione. Per vederli qui, esegui prima: big-storage-rescue --migrate-state"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:157 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1194
msgid "Device ready"
msgstr "Dispositivo pronto"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:158
msgid "You can read and write files on this device."
msgstr "Puoi leggere e scrivere file su questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:161
msgid "Device not mounted"
msgstr "Dispositivo non montato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:162
msgid "The filesystem is not mounted at the moment."
msgstr "Il file system non è montato in questo momento."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:163
msgid "Open the device in the file manager (Dolphin) to mount it."
msgstr "Apri il dispositivo nel gestore di file (Dolphin) per montarlo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:166 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:172 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:179 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:201
msgid "Read-only device"
msgstr "Dispositivo in sola lettura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:167
msgid "The device itself is write-protected, so no system can write to it."
msgstr "Il dispositivo stesso è protetto da scrittura, quindi nessun sistema può scriverci."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:168
msgid "SD cards and some USB drives have a small lock switch on the side. Remove the device, move the switch to the unlocked position and connect it again."
msgstr "Le schede SD e alcune unità USB hanno un piccolo interruttore di blocco sul lato. Rimuovi il dispositivo, sposta l'interruttore in posizione di sblocco e ricollegalo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:169
msgid "If there is no switch, the device may have locked itself because of wear. Copy your files to another place as soon as possible."
msgstr "Se non c'è nessun interruttore, il dispositivo potrebbe essersi bloccato da solo a causa dell'usura. Copia i tuoi file in un altro posto il prima possibile."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:173
msgid "This kind of filesystem cannot be written on Linux with the driver in use."
msgstr "Su Linux, con il driver in uso, non è possibile scrivere su questo tipo di file system."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:174
msgid "CDs, DVDs and disk images (ISO, SquashFS) are read-only by nature."
msgstr "CD, DVD e immagini disco (ISO, SquashFS) sono per natura in sola lettura."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:175
msgid "Drives formatted on a Mac (HFS+ with journaling, APFS) can only be read on Linux."
msgstr "Le unità formattate su un Mac (HFS+ con journaling, APFS) possono essere solo lette su Linux."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:176
msgid "To write to it, copy the files elsewhere and format the device with a filesystem such as exFAT. Formatting erases everything on it."
msgstr "Per scriverci, copia i file altrove e formatta il dispositivo con un file system come exFAT. La formattazione cancella tutto il suo contenuto."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:180
msgid "Windows did not close this NTFS partition properly (hibernation, Fast Startup or an interrupted shutdown). Writing to it now could damage files."
msgstr "Windows non ha chiuso correttamente questa partizione NTFS (ibernazione, Avvio rapido o un arresto interrotto). Scriverci ora potrebbe danneggiare i file."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:181
msgid "Start Windows and shut it down completely: hold the Shift key while you click Shut down."
msgstr "Avvia Windows e arrestalo completamente: tieni premuto il tasto Maiusc mentre fai clic su «Arresta il sistema»."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:182
msgid "To avoid this in the future, disable Fast Startup in Windows: Control Panel > Power Options > Choose what the power buttons do."
msgstr "Per evitarlo in futuro, disattiva l'Avvio rapido in Windows: Pannello di controllo > Opzioni risparmio energia > Specifica comportamento pulsanti di alimentazione."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:183
msgid "If it still happens, check the partition in Windows: open the Command Prompt as administrator and run chkdsk with the /f option for that drive letter."
msgstr "Se succede ancora, controlla la partizione in Windows: apri il Prompt dei comandi come amministratore ed esegui chkdsk con l'opzione /f per la lettera di quell'unità."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:184
msgid "Big Storage Rescue never repairs NTFS by itself, because the repair tools available on Linux may discard data that Windows still needs."
msgstr "Big Storage Rescue non ripara mai NTFS da solo, perché gli strumenti di riparazione disponibili su Linux potrebbero scartare dati di cui Windows ha ancora bisogno."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:187
msgid "The filesystem needs attention"
msgstr "Il file system richiede attenzione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:188
msgid "The system found errors in the filesystem and stopped writing to it to protect your files."
msgstr "Il sistema ha trovato errori nel file system e ha smesso di scriverci per proteggere i tuoi file."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:189
msgid "First copy your important files to another place."
msgstr "Per prima cosa copia i tuoi file importanti in un altro posto."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:190
msgid "Then check the filesystem with the device unmounted, for example with KDE Partition Manager (Check)."
msgstr "Poi controlla il file system con il dispositivo smontato, per esempio con KDE Partition Manager (Controlla)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:191
msgid "Do not write to the device until it has been checked."
msgstr "Non scrivere sul dispositivo finché non è stato controllato."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:194
msgid "The device has read or write errors"
msgstr "Il dispositivo ha errori di lettura o scrittura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:195
msgid "The device reported read or write errors. This is usually a bad cable, a weak USB port or a failing drive."
msgstr "Il dispositivo ha segnalato errori di lettura o scrittura. Di solito si tratta di un cavo difettoso, di una porta USB debole o di un'unità che si sta guastando."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:196 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:974
msgid "Copy your important files to another place as soon as possible."
msgstr "Copia i tuoi file importanti in un altro posto il prima possibile."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:197
msgid "Try another cable and connect the device directly to the computer, without a hub."
msgstr "Prova un altro cavo e collega il dispositivo direttamente al computer, senza hub."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:198
msgid "Check the health of the drive in KDE Partition Manager (SMART status)."
msgstr "Controlla lo stato di salute dell'unità in KDE Partition Manager (stato SMART)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:202
msgid "The filesystem was mounted read-only, but no problem was found with it."
msgstr "Il file system è stato montato in sola lettura, ma non è stato trovato alcun problema."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:203
msgid "Mount it again with writing enabled."
msgstr "Montalo di nuovo con la scrittura abilitata."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:204
msgid "Mount again with writing"
msgstr "Rimonta in scrittura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:205
msgid "The device will be unmounted and mounted again with writing enabled. Nothing on it is changed. Programs using it must be closed first."
msgstr "Il dispositivo verrà smontato e montato di nuovo con la scrittura abilitata. Il suo contenuto non viene modificato. Prima vanno chiusi i programmi che lo stanno usando."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:208 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:216 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:221 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:235
msgid "No permission to write"
msgstr "Nessun permesso di scrittura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:209
msgid "The device accepts writing, but its main folder belongs to another user and you are not allowed to change it."
msgstr "Il dispositivo accetta la scrittura, ma la sua cartella principale appartiene a un altro utente e non hai il permesso di modificarla."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:210
msgid "You can become the owner of the main folder. Only that folder changes: the files and folders inside it keep their owners."
msgstr "Puoi diventare il proprietario della cartella principale. Cambia solo quella cartella: i file e le cartelle al suo interno mantengono i loro proprietari."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:211
msgid "This is the usual fix for drives formatted with a Linux filesystem (ext4, Btrfs, XFS)."
msgstr "È la soluzione abituale per le unità formattate con un file system Linux (ext4, Btrfs, XFS)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:212
msgid "Become owner of the main folder"
msgstr "Diventa proprietario della cartella principale"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:213
msgid "The main folder of the device will belong to you (not recursive: the files and folders inside keep their owners). The administrator password may be requested."
msgstr "La cartella principale del dispositivo apparterrà a te (non in modo ricorsivo: i file e le cartelle al suo interno mantengono i loro proprietari). Potrebbe essere richiesta la password di amministratore."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:217
msgid "This partition contains an operating system. Its folders belong to that system and must keep their owners."
msgstr "Questa partizione contiene un sistema operativo. Le sue cartelle appartengono a quel sistema e devono mantenere i loro proprietari."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:218
msgid "Save your files in a folder that belongs to you, for example your home folder on that system."
msgstr "Salva i tuoi file in una cartella che ti appartiene, per esempio la tua cartella home su quel sistema."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:222
msgid "This folder belongs to %s, and only its owner can create or change files in it."
msgstr "Questa cartella appartiene a %s e solo il suo proprietario può creare o modificare file al suo interno."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:223
msgid "Save your files in a folder of your own, for example in your home folder."
msgstr "Salva i tuoi file in una cartella tua, per esempio nella tua cartella home."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:226
msgid "System partition"
msgstr "Partizione di sistema"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:227
msgid "This partition holds the operating system that is running now. Only the system and administrators write here."
msgstr "Questa partizione contiene il sistema operativo in esecuzione. Solo il sistema e gli amministratori scrivono qui."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:228
msgid "Save your files in your home folder."
msgstr "Salva i tuoi file nella tua cartella home."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:231
msgid "Swap space"
msgstr "Spazio di swap"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:232
msgid "This partition is used as swap space (virtual memory), not to store files."
msgstr "Questa partizione è usata come spazio di swap (memoria virtuale), non per archiviare file."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:236
msgid "The device was mounted for another user, so only that user can write to it."
msgstr "Il dispositivo è stato montato per un altro utente, quindi solo quell'utente può scriverci."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:237
msgid "Unmount it and open it again from the file manager while you are logged in."
msgstr "Smontalo e aprilo di nuovo dal gestore di file mentre hai effettuato l'accesso."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:239
msgid "This internal partition is mounted by Big-Mount at boot. An administrator can choose who may write to it with PERMISSIONS in /etc/big-mount.conf."
msgstr "Questa partizione interna viene montata da Big-Mount all'avvio. Un amministratore può scegliere chi può scriverci con PERMISSIONS in /etc/big-mount.conf."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:241
msgid "Mount again for my user"
msgstr "Rimonta per il mio utente"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:242
msgid "The device will be unmounted and mounted again for your user. Nothing on it is changed. Programs using it must be closed first."
msgstr "Il dispositivo verrà smontato e montato di nuovo per il tuo utente. Il suo contenuto non viene modificato. Prima vanno chiusi i programmi che lo stanno usando."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:245
msgid "Unknown state"
msgstr "Stato sconosciuto"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:246
msgid "The state of this device could not be determined."
msgstr "Non è stato possibile determinare lo stato di questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:255 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:930 big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:57
msgid "unknown"
msgstr "sconosciuto"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:286
msgid "system"
msgstr "sistema"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:291
msgid "other"
msgstr "altro"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:304 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:602 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:314 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:252
msgid "Device"
msgstr "Dispositivo"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:305 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:603 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:266
msgid "Filesystem"
msgstr "File system"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:307 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:604 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:270
msgid "Mounted at"
msgstr "Montato su"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:308
msgid "Folder"
msgstr "Cartella"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:310
msgid "Writable, but not by your user"
msgstr "Scrivibile, ma non dal tuo utente"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:310 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:269
msgid "Status"
msgstr "Stato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:314 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:973
msgid "How to solve:"
msgstr "Come risolvere:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:318
msgid "Attention: the filesystem has recorded errors. Copy important files elsewhere and check it soon."
msgstr "Attenzione: il file system ha registrato degli errori. Copia altrove i file importanti e controllalo al più presto."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:321
msgid "Attention: the drive that holds this device reported errors since the computer was started. Copy important files elsewhere and check the drive."
msgstr "Attenzione: l'unità che contiene questo dispositivo ha segnalato errori dall'avvio del computer. Copia altrove i file importanti e controlla l'unità."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:394
msgid "To see the errors of the drive: big-storage-rescue --diagnose %s"
msgstr "Per vedere gli errori dell'unità: big-storage-rescue --diagnose %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:396 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1030
msgid "Technical details:"
msgstr "Dettagli tecnici:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412 big-storage-rescue/usr/lib/big-storage-rescue/drive-tui.sh:87
msgid "DEVICE"
msgstr "DISPOSITIVO"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412
msgid "LABEL"
msgstr "ETICHETTA"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412
msgid "SIZE"
msgstr "DIMENSIONE"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412
msgid "FS"
msgstr "FS"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412
msgid "MANAGED BY"
msgstr "GESTITO DA"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412
msgid "MOUNTED AT"
msgstr "MONTATO SU"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:412
msgid "STATE"
msgstr "STATO"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:422
msgid "not mounted"
msgstr "non montato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:424
msgid "in use by the system"
msgstr "in uso dal sistema"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:426
msgid "READ-ONLY"
msgstr "SOLA LETTURA"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:428
msgid "read and write"
msgstr "lettura e scrittura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:430
msgid "no write permission"
msgstr "senza permesso di scrittura"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:444
msgid "Storage devices"
msgstr "Dispositivi di archiviazione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:458
msgid "To find out why a device cannot be written to, run: big-storage-rescue --diagnose DEVICE"
msgstr "Per scoprire perché non è possibile scrivere su un dispositivo, esegui: big-storage-rescue --diagnose DISPOSITIVO"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:465 big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:399
msgid "Running system"
msgstr "Sistema in esecuzione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:472
msgid "Environment"
msgstr "Ambiente"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:475
msgid "not installed"
msgstr "non installato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:476
msgid "present: automount disabled"
msgstr "presente: montaggio automatico disattivato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:477
msgid "available"
msgstr "disponibile"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:477 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:948
msgid "not available"
msgstr "non disponibile"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:480
msgid "installed"
msgstr "installato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:480
msgid "missing"
msgstr "mancante"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:482
msgid "readable"
msgstr "leggibile"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:482
msgid "not readable (fewer details for errors)"
msgstr "non leggibile (meno dettagli sugli errori)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:483
msgid "kernel log"
msgstr "registro del kernel"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:519
msgid "Also mounted at %s"
msgstr "Montato anche su %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:520
msgid "Another device is mounted inside it: %s"
msgstr "Al suo interno è montato un altro dispositivo: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:521
msgid "A swap file on it is in use: %s"
msgstr "È in uso un file di swap che si trova su di esso: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:522
msgid "It is in use as swap space"
msgstr "È in uso come spazio di swap"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:523
msgid "A disk image stored on it is attached: %s"
msgstr "È collegata un'immagine disco archiviata su di esso: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:524
msgid "It is used by %s (encryption, LVM or RAID)"
msgstr "È usato da %s (cifratura, LVM o RAID)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:525
msgid "Also mounted inside an isolated environment (a container or a sandboxed service): %s"
msgstr "Montato anche all'interno di un ambiente isolato (un container o un servizio in sandbox): %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:554
msgid "A container or a sandboxed service has its own mount of this device (see below). Unmounting it here does not release the device while that mount exists."
msgstr "Un container o un servizio in sandbox ha un proprio montaggio di questo dispositivo (vedi sotto). Smontarlo qui non libera il dispositivo finché quel montaggio esiste."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:555
msgid "Stop that container or service first. Big Storage Rescue waits for it before saying the device can be disconnected."
msgstr "Ferma prima quel container o servizio. Big Storage Rescue lo attende prima di dire che il dispositivo può essere scollegato."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:557
msgid "No program is using it, but the system still is (see below)."
msgstr "Nessun programma lo sta usando, ma il sistema sì (vedi sotto)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:558
msgid "Resolve the item listed below, then try again."
msgstr "Risolvi l'elemento elencato qui sotto, poi riprova."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:560
msgid "None of your programs is using it. A system service or a program of another user may be holding it, or it was released a moment ago."
msgstr "Nessuno dei tuoi programmi lo sta usando. Potrebbe trattenerlo un servizio di sistema o un programma di un altro utente, oppure è stato rilasciato un attimo fa."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:561
msgid "Try again. If it is still busy, show the programs of all users."
msgstr "Riprova. Se è ancora occupato, mostra i programmi di tutti gli utenti."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:567
msgid "%s has a file open for writing on this device."
msgstr "%s ha un file aperto in scrittura su questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:568
msgid "Let it finish, or cancel the operation in that program, then try again."
msgstr "Lascialo finire, oppure annulla l'operazione in quel programma, poi riprova."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:569
msgid "A terminal is open in a folder of this device."
msgstr "È aperto un terminale in una cartella di questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:570
msgid "Type cd in that terminal, or close it, then try again."
msgstr "Digita cd in quel terminale, oppure chiudilo, poi riprova."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:571
msgid "%s is showing or reading files of this device."
msgstr "%s sta mostrando o leggendo file di questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:572
msgid "Close the window or tab that shows the device, then try again."
msgstr "Chiudi la finestra o la scheda che mostra il dispositivo, poi riprova."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:573
msgid "The file indexer is reading this device."
msgstr "L'indicizzatore dei file sta leggendo questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:574
msgid "It usually finishes in a moment: try again shortly."
msgstr "Di solito finisce in un attimo: riprova tra poco."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:575
msgid "%s is running inside a folder of this device."
msgstr "%s è in esecuzione all'interno di una cartella di questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:576 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:578
msgid "Close that program, then try again."
msgstr "Chiudi quel programma, poi riprova."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:577
msgid "%s is using files on this device."
msgstr "%s sta usando file su questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:581
msgid "In total, %d programs are using it."
msgstr "In totale, %d programmi lo stanno usando."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:594
msgid "In use"
msgstr "In uso"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:598
msgid "%s is still in use"
msgstr "%s è ancora in uso"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:608
msgid "Programs using it:"
msgstr "Programmi che lo usano:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:610 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:612
msgid "Application"
msgstr "Applicazione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:610 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:612
msgid "process"
msgstr "processo"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:610
msgid "User"
msgstr "Utente"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:610 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:612
msgid "Activity"
msgstr "Attività"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:628
msgid "Also keeping it busy:"
msgstr "Lo tengono occupato anche:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:632
msgid "An open file does not necessarily mean that something is being copied."
msgstr "Un file aperto non significa necessariamente che si stia copiando qualcosa."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:659
msgid "%s is not in use"
msgstr "%s non è in uso"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:661
msgid "No program and nothing in the system is using it. It can be unmounted."
msgstr "Nessun programma e niente nel sistema lo sta usando. Può essere smontato."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:663
msgid "None of your programs is using %s"
msgstr "Nessuno dei tuoi programmi sta usando %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:665
msgid "No program of yours, no other mount and no other device is using it. It can probably be unmounted. Programs of other users and of the system are only visible to an administrator."
msgstr "Nessuno dei tuoi programmi, nessun altro montaggio e nessun altro dispositivo lo sta usando. Probabilmente può essere smontato. I programmi di altri utenti e del sistema sono visibili solo a un amministratore."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:693
msgid "The device was disconnected or replaced during the operation. Nothing else was done."
msgstr "Il dispositivo è stato scollegato o sostituito durante l'operazione. Non è stato fatto nient'altro."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:752
msgid "%s was mounted again at %s"
msgstr "%s è stato montato di nuovo su %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:768
msgid "%s: the encrypted volume could not be locked"
msgstr "%s: non è stato possibile bloccare il volume cifrato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:810
msgid "They do not start again by themselves when the device comes back."
msgstr "Non si riavviano da soli quando il dispositivo torna disponibile."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:812
msgid "They start again by themselves when the device is mounted again."
msgstr "Si riavviano da soli quando il dispositivo viene montato di nuovo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:855 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:495
msgid "Another removal of this drive is in progress. Nothing was done."
msgstr "È già in corso un'altra rimozione di questa unità. Non è stato fatto nulla."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:871
msgid "Device removed safely. It can be disconnected now."
msgstr "Dispositivo rimosso in sicurezza. Ora può essere scollegato."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:873 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:514
msgid "Unmounted. Everything was written to the device."
msgstr "Smontato. Tutti i dati sono stati scritti sul dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:885
msgid "These programs can be asked to close (unsaved changes in them may be lost):"
msgstr "A questi programmi si può chiedere di chiudersi (le modifiche non salvate potrebbero andare perse):"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:889 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1244
msgid "Close them"
msgstr "Chiudili"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:889 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:902 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1168 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1220 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1244 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1317
msgid "Cancel"
msgstr "Annulla"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:892
msgid "Still running: %s"
msgstr "Ancora in esecuzione: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:895 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:519
msgid "These services use the device and will be stopped when it is unmounted:"
msgstr "Questi servizi usano il dispositivo e verranno fermati quando verrà smontato:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:902
msgid "Stop them and continue"
msgstr "Fermali e continua"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:905
msgid "Nothing was done. Run again with --assume-yes to stop them."
msgstr "Non è stato fatto nulla. Esegui di nuovo con --assume-yes per fermarli."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:909
msgid "Unmounted, but powering the drive off failed (%s). Wait a moment before disconnecting it."
msgstr "Smontato, ma lo spegnimento dell'unità non è riuscito (%s). Attendi un momento prima di scollegarla."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:910 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:516
msgid "Refused: this drive holds the running system (%s)."
msgstr "Operazione rifiutata: questa unità contiene il sistema in esecuzione (%s)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:911 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:517
msgid "Permission to unmount was not granted."
msgstr "Il permesso di smontare non è stato concesso."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:912
msgid "Unmounted, but the drive is still in use (%s), so it was not powered off."
msgstr "Smontato, ma l'unità è ancora in uso (%s), quindi non è stata spenta."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:913
msgid "Unmounted. This drive cannot be powered off by the computer; it can be disconnected now."
msgstr "Smontato. Questa unità non può essere spenta dal computer; ora può essere scollegata."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:916 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:523
msgid "Could not unmount: %s"
msgstr "Impossibile smontare: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:937
msgid "The drive reports errors"
msgstr "L'unità segnala errori"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:938
msgid "The drive had errors before this start of the computer"
msgstr "L'unità ha avuto errori prima di questo avvio del computer"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:939
msgid "No drive errors found"
msgstr "Nessun errore dell'unità trovato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:943
msgid "Drive"
msgstr "Unità"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:944 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:313 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:251
msgid "Connection"
msgstr "Connessione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:946
msgid "no problem reported"
msgstr "nessun problema segnalato"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:947
msgid "the drive predicts its own failure"
msgstr "l'unità prevede un proprio guasto"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:951
msgid "no failure predicted (%s damaged sectors were replaced by spare ones)"
msgstr "nessun guasto previsto (%s settori danneggiati sono stati sostituiti da settori di riserva)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:953
msgid "SMART status"
msgstr "Stato SMART"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:956
msgid "Since the computer was started, the system recorded no read, write or connection errors for this drive."
msgstr "Dall'avvio del computer, il sistema non ha registrato errori di lettura, scrittura o connessione per questa unità."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:958
msgid "The kernel log cannot be read by your user, so recent errors of this drive cannot be checked."
msgstr "Il registro del kernel non è leggibile dal tuo utente, quindi non è possibile controllare gli errori recenti di questa unità."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:963
msgid "Problems found:"
msgstr "Problemi trovati:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:966 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:240
msgid "The drive itself reports that it is failing (SMART)."
msgstr "L'unità stessa segnala che si sta guastando (SMART)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:967 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:245
msgid "Since the computer was started, it stopped answering and the connection had to be reset (%s kernel messages)."
msgstr "Dall'avvio del computer, ha smesso di rispondere ed è stato necessario reimpostare la connessione (%s messaggi del kernel)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:968 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:244
msgid "Since the computer was started, reading or writing failed (%s kernel messages)."
msgstr "Dall'avvio del computer, la lettura o la scrittura non sono riuscite (%s messaggi del kernel)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:969 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:247
msgid "Since the computer was started, the connection was slowed down after errors."
msgstr "Dall'avvio del computer, la connessione è stata rallentata dopo alcuni errori."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:970 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:246
msgid "Since the computer was started, the USB connection was reset or lost %s times."
msgstr "Dall'avvio del computer, la connessione USB è stata reimpostata o persa %s volte."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:975
msgid "Check the data and power cables of the drive, or try another SATA port."
msgstr "Controlla i cavi dati e di alimentazione dell'unità, oppure prova un'altra porta SATA."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:976
msgid "An SSD that fails like this may lock itself in a protection mode: it seems to accept writing, but keeps nothing. Copy what you can first; no repair is worth more than your files."
msgstr "Un SSD che si guasta in questo modo può bloccarsi in una modalità di protezione: sembra accettare la scrittura, ma non conserva nulla. Prima copia ciò che puoi: nessuna riparazione vale più dei tuoi file."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:977
msgid "If the errors come back, replace the drive."
msgstr "Se gli errori si ripresentano, sostituisci l'unità."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:986
msgid "From before this start of the computer:"
msgstr "Da prima di questo avvio del computer:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:988 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:254
msgid "In %s of the last %s starts of the computer, the drive had read or connection errors (%s kernel messages)."
msgstr "In %s degli ultimi %s avvii del computer, l'unità ha avuto errori di lettura o di connessione (%s messaggi del kernel)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:991 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:256
msgid "They were errors of the connection: check the data cable and the power connector of the drive, or try another port."
msgstr "Erano errori di connessione: controlla il cavo dati e il connettore di alimentazione dell'unità, oppure prova un'altra porta."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:995 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:260
msgid "Its filesystems recorded %s errors, which are kept across restarts (%s)."
msgstr "I suoi file system hanno registrato %s errori, che vengono conservati tra un riavvio e l'altro (%s)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:997
msgid "After the cause is solved (a cable, a drive replaced, the files copied), an administrator can reset them: btrfs device stats -z on Btrfs; e2fsck clears them on ext4."
msgstr "Dopo aver risolto la causa (un cavo, un'unità sostituita, i file copiati), un amministratore può azzerarli: btrfs device stats -z su Btrfs; su ext4 li azzera e2fsck."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1051 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1054 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1098 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1108 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1116
msgid "Storage diagnostics"
msgstr "Diagnostica dell'archiviazione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1051
msgid "No storage device to diagnose was found."
msgstr "Non è stato trovato alcun dispositivo di archiviazione da diagnosticare."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1054 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1108
msgid "Choose a device:"
msgstr "Scegli un dispositivo:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1075 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1078
msgid "Unable to access storage device"
msgstr "Impossibile accedere al dispositivo di archiviazione"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1076
msgid "Big Storage Rescue could not identify this storage device. It may have been disconnected or become temporarily unavailable."
msgstr "Big Storage Rescue non è riuscito a identificare questo dispositivo di archiviazione. Potrebbe essere stato scollegato o essere temporaneamente non disponibile."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1077
msgid "If you disconnected it, connect it again and choose Try again."
msgstr "Se lo hai scollegato, ricollegalo e scegli «Riprova»."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1078 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1220
msgid "Try again"
msgstr "Riprova"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1078 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1085 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1124 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1126 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1129 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1131 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1140 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1233
msgid "Technical details"
msgstr "Dettagli tecnici"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1078 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1124 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1126 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1129 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1131 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1411 big-storage-rescue/usr/lib/big-storage-rescue/ui.sh:234
msgid "Close"
msgstr "Chiudi"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1098
msgid "This folder is not on a local storage device."
msgstr "Questa cartella non si trova su un dispositivo di archiviazione locale."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1126
msgid "Check the drive…"
msgstr "Controlla l'unità…"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1129
msgid "Safely remove…"
msgstr "Rimuovi in sicurezza…"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1155 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1451
msgid "How to solve"
msgstr "Come risolvere"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1176
msgid "Another operation on this drive is in progress. Try again when it finishes."
msgstr "È in corso un'altra operazione su questa unità. Riprova quando sarà terminata."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1194
msgid "You can now write to this device."
msgstr "Ora puoi scrivere su questo dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1196
msgid "Unable to fix the device"
msgstr "Impossibile correggere il dispositivo"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1197
msgid "Nothing was changed on the device. See the technical details for more information."
