msgid "Check the result"
msgstr "Controlla il risultato"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Di base: rsync conferma ogni file durante la copia"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Names, sizes and dates compared at the end"
msgstr "Nomi, dimensioni e date confrontati alla fine"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1022
msgid "Content compared at the end (reads the source again)"
msgstr "Contenuto confrontato alla fine (rilegge l'origine)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1026
msgid "Set aside a stuck file after (seconds)"
msgstr "Metti da parte un file bloccato dopo (secondi)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1028
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "Un file la cui copia non avanza per questo tempo viene messo da parte, così gli altri vengono salvati per primi. 0: mai."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1032
msgid "Limit the reading speed (kB/s)"
msgstr "Limita la velocità di lettura (kB/s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1034
msgid "0: no limit"
msgstr "0: nessun limite"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1045
msgid "Starting…"
msgstr "Avvio in corso…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1084
msgid "Read the partition table"
msgstr "Leggi la tabella delle partizioni"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1085
msgid "Analyze the whole disk"
msgstr "Analizza l'intero disco"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1086
msgid "It reads all of the disk. On a drive with problems this is extra wear."
msgstr "Legge tutto il disco. Su un'unità con problemi, questo significa usura aggiuntiva."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1089
msgid "This drive reported problems: analyzing all of it is extra wear. A disk image first spares it."
msgstr "Questa unità ha segnalato problemi: analizzarla tutta significa usura aggiuntiva. Un'immagine disco creata prima la risparmia."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1111
msgid "Stopping…"
msgstr "Arresto in corso…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1118
msgid "Volumes this drive already has"
msgstr "Volumi già presenti su questa unità"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1119
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "Non sono persi. Per recuperarne i file, copiarli è più rapido e legge il disco meno di qualsiasi analisi."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1124
msgid "Recover its files"
msgstr "Recuperane i file"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1136
msgid "Looking for partitions…"
msgstr "Ricerca delle partizioni…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1140
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "TestDisk non indica a che punto è arrivato, quindi non c'è una percentuale. L'analisi di un intero disco lo legge tutto e può richiedere ore; nel frattempo l'unità non può essere usata per nient'altro."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1151
#, python-format
msgid "Elapsed: %s"
msgstr "Trascorso: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1171
msgid "The search failed."
msgstr "La ricerca non è riuscita."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1174
msgid "What TestDisk found"
msgstr "Cosa ha trovato TestDisk"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1180
msgid "Big Storage Rescue does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "Big Storage Rescue non riscrive le tabelle delle partizioni, di proposito: un errore lì può far perdere tutto. Un'immagine disco, o una ricerca per contenuto, recupera i file senza questo rischio."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1182
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "L'analisi non ha riconosciuto alcuna partizione. Questo non prova che non ci siano dati: una ricerca per contenuto potrebbe ancora trovare dei file."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1184
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "La tabella delle partizioni è vuota o illeggibile. Analizzare l'intero disco potrebbe trovare ciò che non elenca più."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:256
msgid "This picture cannot be shown"
msgstr "Impossibile mostrare questa immagine"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:257
msgid "It may be incomplete. That is common with files found by content."
msgstr "Potrebbe essere incompleta. È comune con i file trovati per contenuto."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:302 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:303
msgid "Search by name"
msgstr "Cerca per nome"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "As found"
msgstr "Come trovati"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "Largest first"
msgstr "Prima i più grandi"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "By name"
msgstr "Per nome"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:306
msgid "Order"
msgstr "Ordinamento"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:320
msgid "Name"
msgstr "Nome"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:324
msgid "Date"
msgstr "Data"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:329
msgid "Reading the list…"
msgstr "Lettura dell'elenco…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:331
msgid "Nothing to show"
msgstr "Niente da mostrare"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:332
msgid "No file matches what you asked for."
msgstr "Nessun file corrisponde a ciò che hai chiesto."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:339
msgid "Recover selected"
msgstr "Recupera i selezionati"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:341
msgid "Select all shown"
msgstr "Seleziona tutti quelli mostrati"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:342
msgid "Clear selection"
msgstr "Annulla la selezione"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:349 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:680
msgid "Save report"
msgstr "Salva il rapporto"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:350
msgid "Try another method"
msgstr "Prova un altro metodo"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:386
msgid "Candidates found by content. They are saved in the destination folder, without their names and folders, and some may be incomplete. Check them before deleting anything."
msgstr "Candidati trovati per contenuto. Vengono salvati nella cartella di destinazione, senza i loro nomi e cartelle, e alcuni potrebbero essere incompleti. Controllali prima di eliminare qualsiasi cosa."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:388
#, python-format
msgid "By their structure: %(whole)d look whole, %(short)d are cut short, %(bad)d are damaged and %(other)d could not be checked. Whole does not prove every byte is right: open the files that matter."
msgstr "In base alla struttura: %(whole)d sembrano integri, %(short)d sono troncati, %(bad)d sono danneggiati e %(other)d non sono controllabili. Integro non prova che ogni byte sia corretto: apri i file che contano."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:391
msgid "Copy selected to another folder"
msgstr "Copia i selezionati in un'altra cartella"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:393
msgid "These files exist on the volume and have not been copied yet. Deleted files are not on this list."
msgstr "Questi file esistono sul volume e non sono ancora stati copiati. I file eliminati non sono in questo elenco."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:406
#, python-format
msgid "All (%d)"
msgstr "Tutti (%d)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:427
msgid "The list could not be read."
msgstr "Non è stato possibile leggere l'elenco."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:525
#, python-format
msgid "%(shown)d shown, %(sel)d selected (%(size)s)"
msgstr "%(shown)d mostrati, %(sel)d selezionati (%(size)s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:542
msgid "Select"
msgstr "Seleziona"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:567
msgid "Preview"
msgstr "Anteprima"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:638
msgid "It cannot be copied"
msgstr "Non può essere copiato"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:641
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "%d file con un a capo nel nome è stato escluso. Non può essere gestito in modo sicuro."
msgstr[1] "%d file con un a capo nel nome sono stati esclusi. Non possono essere gestiti in modo sicuro."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:667
msgid "It cannot be saved here"
msgstr "Non può essere salvato qui"

