#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:975
#, python-format
msgid "%(files)s files, %(size)s"
msgstr "%(files)s fichiers, %(size)s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:979
msgid "Free at the destination"
msgstr "Espace libre à la destination"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:981
msgid "Already there, with different content"
msgstr "Déjà présents, avec un contenu différent"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:984
msgid "Your files will be copied with their names. Nothing is written to the source."
msgstr "Vos fichiers seront copiés avec leurs noms. Rien n’est écrit sur la source."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:985
msgid "First a list of what exists is made. Then you choose what to copy. Nothing is written to the source."
msgstr "Une liste de ce qui existe est d’abord établie. Vous choisissez ensuite ce qu’il faut copier. Rien n’est écrit sur la source."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:986
msgid "Files will be searched for by their content. Names and folders are lost, some files may come out incomplete, and finding nothing is possible. Nothing is written to the source."
msgstr "Les fichiers seront recherchés d’après leur contenu. Les noms et les dossiers sont perdus, certains fichiers peuvent être incomplets, et il est possible de ne rien trouver. Rien n’est écrit sur la source."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:987
msgid "The disk is read once, into a file. Nothing is written to it."
msgstr "Le disque est lu une seule fois, dans un fichier. Rien n’y est écrit."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:992
msgid "After the image, the search needs your confirmation. It can also be started later."
msgstr "Après l’image, la recherche nécessite votre confirmation. Elle peut aussi être lancée plus tard."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:994
msgid "Good to know"
msgstr "Bon à savoir"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1004
#, python-format
msgid "%d item you marked"
msgid_plural "%d items you marked"
msgstr[0] "%d élément que vous avez marqué"
msgstr[1] "%d éléments que vous avez marqués"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1014
msgid "If a file already exists"
msgstr "Si un fichier existe déjà"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1019
msgid "Check the result"
msgstr "Vérifier le résultat"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Simple : rsync confirme chaque fichier au moment de la copie"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Names, sizes and dates compared at the end"
msgstr "Noms, tailles et dates comparés à la fin"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1022
msgid "Content compared at the end (reads the source again)"
msgstr "Contenu comparé à la fin (relit la source)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1026
msgid "Set aside a stuck file after (seconds)"
msgstr "Mettre de côté un fichier bloqué après (secondes)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1028
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "Un fichier qui n’avance pas pendant cette durée est mis de côté, pour que les autres soient sauvés en premier. 0 : jamais."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1032
msgid "Limit the reading speed (kB/s)"
msgstr "Limiter la vitesse de lecture (ko/s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1034
msgid "0: no limit"
msgstr "0 : aucune limite"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1045
msgid "Starting…"
msgstr "Démarrage…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1084
msgid "Read the partition table"
msgstr "Lire la table de partitions"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1085
msgid "Analyze the whole disk"
msgstr "Analyser tout le disque"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1086
msgid "It reads all of the disk. On a drive with problems this is extra wear."
msgstr "Le disque est lu entièrement. Sur un disque qui présente des problèmes, c’est une usure supplémentaire."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1089
msgid "This drive reported problems: analyzing all of it is extra wear. A disk image first spares it."
msgstr "Ce disque a signalé des problèmes : l’analyser entièrement l’use davantage. Une image disque préalable le ménage."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1111
msgid "Stopping…"
msgstr "Arrêt…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1118
msgid "Volumes this drive already has"
msgstr "Volumes déjà présents sur ce disque"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1119
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "Ils ne sont pas perdus. Pour récupérer leurs fichiers, les copier est plus rapide et sollicite moins le disque que n’importe quelle analyse."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1124
msgid "Recover its files"
msgstr "Récupérer ses fichiers"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1136
msgid "Looking for partitions…"
msgstr "Recherche de partitions…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1140
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "TestDisk n’indique pas son avancement : il n’y a donc pas de pourcentage. L’analyse d’un disque entier le lit en totalité et peut prendre des heures ; le disque ne peut servir à rien d’autre pendant ce temps."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1151
#, python-format
msgid "Elapsed: %s"
msgstr "Écoulé : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1171
msgid "The search failed."
msgstr "La recherche a échoué."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1174
msgid "What TestDisk found"
msgstr "Ce que TestDisk a trouvé"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1180
msgid "Big Storage Rescue does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "Big Storage Rescue ne réécrit pas les tables de partitions, volontairement : une erreur à ce niveau peut tout faire perdre. Une image disque, ou une recherche par contenu, récupère les fichiers sans ce risque."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1182
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "L’analyse n’a reconnu aucune partition. Cela ne prouve pas qu’il n’y a pas de données : une recherche par contenu peut encore trouver des fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1184
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "La table de partitions est vide ou illisible. L’analyse du disque entier peut trouver ce qu’elle ne liste plus."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:256
msgid "This picture cannot be shown"
msgstr "Impossible d’afficher cette image"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:257
msgid "It may be incomplete. That is common with files found by content."
msgstr "Elle est peut-être incomplète. C’est courant avec les fichiers trouvés par leur contenu."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:302 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:303
msgid "Search by name"
msgstr "Rechercher par nom"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "As found"
msgstr "Ordre de découverte"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "Largest first"
msgstr "Les plus gros d’abord"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "By name"
msgstr "Par nom"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:306
msgid "Order"
msgstr "Ordre"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:320
msgid "Name"
msgstr "Nom"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:324
msgid "Date"
msgstr "Date"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:329
msgid "Reading the list…"
msgstr "Lecture de la liste…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:331
msgid "Nothing to show"
msgstr "Rien à afficher"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:332
msgid "No file matches what you asked for."
msgstr "Aucun fichier ne correspond à votre demande."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:339
msgid "Recover selected"
msgstr "Récupérer la sélection"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:341
msgid "Select all shown"
msgstr "Sélectionner tout ce qui est affiché"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:342
msgid "Clear selection"
msgstr "Effacer la sélection"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:349 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:680
msgid "Save report"
msgstr "Enregistrer le rapport"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:350
msgid "Try another method"
msgstr "Essayer une autre méthode"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:386
msgid "Candidates found by content. They are saved in the destination folder, without their names and folders, and some may be incomplete. Check them before deleting anything."
msgstr "Candidats trouvés par leur contenu. Ils sont enregistrés dans le dossier de destination, sans leurs noms ni leurs dossiers, et certains peuvent être incomplets. Vérifiez-les avant de supprimer quoi que ce soit."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:388
#, python-format
msgid "By their structure: %(whole)d look whole, %(short)d are cut short, %(bad)d are damaged and %(other)d could not be checked. Whole does not prove every byte is right: open the files that matter."
msgstr "D’après leur structure : %(whole)d semblent intacts, %(short)d sont tronqués, %(bad)d sont endommagés et %(other)d n’ont pas pu être vérifiés. Intact ne prouve pas que chaque octet est correct : ouvrez les fichiers qui comptent."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:391
msgid "Copy selected to another folder"
msgstr "Copier la sélection dans un autre dossier"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:393
msgid "These files exist on the volume and have not been copied yet. Deleted files are not on this list."
msgstr "Ces fichiers existent sur le volume et n’ont pas encore été copiés. Les fichiers supprimés ne figurent pas dans cette liste."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:406
#, python-format
msgid "All (%d)"
msgstr "Tous (%d)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:427
msgid "The list could not be read."
msgstr "La liste n’a pas pu être lue."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:525
#, python-format
msgid "%(shown)d shown, %(sel)d selected (%(size)s)"
msgstr "%(shown)d affichés, %(sel)d sélectionnés (%(size)s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:542
msgid "Select"
msgstr "Sélectionner"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:567
msgid "Preview"
msgstr "Aperçu"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:638
msgid "It cannot be copied"
msgstr "Impossible de le copier"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:641
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "%d fichier dont le nom contient un saut de ligne a été omis. Il ne peut pas être traité en toute sécurité."
msgstr[1] "%d fichiers dont le nom contient un saut de ligne ont été omis. Ils ne peuvent pas être traités en toute sécurité."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:667
msgid "It cannot be saved here"
msgstr "Impossible de l’enregistrer ici"

#: locale/templates/big-storage-rescue-notifier.desktop.in:3
msgid "Big Storage Rescue notifier"
msgstr "Notificateur de Big Storage Rescue"

#: locale/templates/big-storage-rescue-notifier.desktop.in:4
msgid "Explains why a storage device cannot be written to"
msgstr "Explique pourquoi il est impossible d’écrire sur un périphérique de stockage"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:6
msgid "Storage device"
msgstr "Périphérique de stockage"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:16
msgid "Safely remove (shows what keeps it busy)"
msgstr "Retirer en toute sécurité (montre ce qui l’occupe)"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:21
msgid "Check the health of this drive"
msgstr "Vérifier la santé de ce disque"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:26
msgid "Recover files from this drive…"
msgstr "Récupérer des fichiers de ce disque…"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:31
msgid "Open in Big Storage Rescue"
msgstr "Ouvrir dans Big Storage Rescue"

#: locale/templates/org.biglinux.big-storage-rescue.desktop.in:4
msgid "Storage diagnosis and file rescue"
msgstr "Diagnostic du stockage et sauvetage de fichiers"

#: locale/templates/org.biglinux.big-storage-rescue.desktop.in:5
msgid "Find out what is wrong with a drive, why it cannot be written to or removed, and rescue your files from it"
msgstr "Découvrez ce qui ne va pas avec un disque, pourquoi il est impossible d’y écrire ou de le retirer, et sauvez-en vos fichiers"

#: locale/templates/org.biglinux.big-storage-rescue.desktop.in:12
msgid "disk;drive;usb;ssd;nvme;sd;read-only;busy;eject;unmount;recover;recovery;rescue;backup;image;ddrescue;testdisk;photorec;smart;health;storage;diagnostics;"
msgstr "disque;lecteur;usb;ssd;nvme;sd;lecture seule;occupé;éjecter;démonter;récupérer;récupération;sauvetage;sauvegarde;image;ddrescue;testdisk;photorec;smart;santé;stockage;diagnostic;disk;drive;recovery;rescue;"

#: locale/templates/org.biglinux.big-storage-rescue.desktop.in:16
msgid "Why can't I write to a device?"
msgstr "Pourquoi ne puis-je pas écrire sur un périphérique ?"

#: locale/templates/org.biglinux.big-storage-rescue.policy.in:11
msgid "Show the programs of all users that keep a storage device busy"
msgstr "Afficher les programmes de tous les utilisateurs qui maintiennent un périphérique de stockage occupé"

#: locale/templates/org.biglinux.big-storage-rescue.policy.in:12
msgid "Authentication is required to see the programs of all users that are using this device"
msgstr "Une authentification est nécessaire pour voir les programmes de tous les utilisateurs qui utilisent ce périphérique"

#: locale/templates/org.biglinux.big-storage-rescue.policy.in:27
msgid "Make a disk image of a storage device"
msgstr "Créer une image disque d’un périphérique de stockage"

#: locale/templates/org.biglinux.big-storage-rescue.policy.in:28
msgid "Authentication is required to make a disk image of this storage device. The image holds everything on it."
msgstr "Une authentification est nécessaire pour créer une image disque de ce périphérique de stockage. L’image contient tout ce qu’il renferme."

#: locale/templates/org.biglinux.big-storage-rescue.policy.in:40
msgid "Protect a storage device, read its health or its partitions"
msgstr "Protéger un périphérique de stockage, lire sa santé ou ses partitions"

#: locale/templates/org.biglinux.big-storage-rescue.policy.in:41
msgid "Authentication is required to protect this storage device, read its health or its partitions"
msgstr "Une authentification est nécessaire pour protéger ce périphérique de stockage, lire sa santé ou ses partitions"
