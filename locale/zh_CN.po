msgid "Kernel log readable (needed to explain read-only devices)"
msgstr "内核日志可读（用于解释设备为何只读）"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:327
msgid "Kernel log not readable by this user: read-only causes are explained with fewer details"
msgstr "此用户无法读取内核日志：只读原因的解释会较为简略"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:340
msgid "%s: %s, %s, removable"
msgstr "%s：%s，%s，可移动"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:342
msgid "%s: %s, %s, internal"
msgstr "%s：%s，%s，内部"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:346
msgid "The kernel has no /sys/block entry for it"
msgstr "内核中没有它的 /sys/block 条目"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:348
msgid "UDisks2 does not know this device: Plasma and Big Storage Rescue cannot manage it"
msgstr "UDisks2 无法识别此设备：Plasma 和 Big Storage Rescue 无法管理它"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:355
msgid "%s: the drive reports problems (%s)"
msgstr "%s：驱动器报告了问题（%s）"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:356 big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:363
msgid "For details: big-storage-rescue --diagnose %s"
msgstr "详细信息：big-storage-rescue --diagnose %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:362
msgid "%s: errors in %s of the last %s starts of the computer (%s kernel messages)"
msgstr "%s：最近的开机记录中有 %s 次（共 %s 次开机）出现错误（%s 条内核消息）"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:367
msgid "%s: its filesystems recorded %s errors, kept across restarts"
msgstr "%s：其文件系统记录了 %s 个错误，这些记录在重启后仍会保留"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:378
msgid "NVMe controller /dev/%s: storage %s"
msgstr "NVMe 控制器 /dev/%s：存储设备 %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:391
msgid "Mounted read-only: %s"
msgstr "以只读方式挂载：%s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:403
msgid "Enough free space, and nothing left mounted by os-prober"
msgstr "可用空间充足，且 os-prober 没有遗留任何挂载"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:418
msgid "Outside Big Storage Rescue (for reference)"
msgstr "Big Storage Rescue 之外（仅供参考）"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:424
msgid "Settings files that do not belong to you (Plasma cannot save them, so settings seem to reset)"
msgstr "不属于您的设置文件（Plasma 无法保存它们，因此设置看起来会被重置）"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:425
msgid "Usually left by a graphical program run with sudo. An administrator can give them back with chown."
msgstr "通常是用 sudo 运行图形程序后遗留的。管理员可以用 chown 将其归还给您。"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:427
msgid "All your settings files belong to you"
msgstr "您的所有设置文件都属于您"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:433
msgid "%d packages have newer versions in the last synchronized package list"
msgstr "在最近同步的软件包列表中，有 %d 个软件包有更新版本"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:434
msgid "Keep the system consistent: update everything at once (sudo pacman -Syu), never only some packages."
msgstr "保持系统的一致性：一次性更新所有软件包（sudo pacman -Syu），切勿只更新部分软件包。"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:447
msgid "Big Storage Rescue check (nothing is changed; labels, serial numbers, UUIDs and personal paths are left out)"
msgstr "Big Storage Rescue 检查（不做任何更改；不包含标签、序列号、UUID 和个人路径）"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:455
msgid "Result: %d problem(s), %d warning(s)."
msgstr "结果：%d 个问题，%d 个警告。"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:456
msgid "Big Storage Rescue and the storage stack look healthy."
msgstr "Big Storage Rescue 和存储组件看起来运行正常。"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:457
msgid "To report a problem, attach this output: big-storage-rescue --doctor > big-storage-rescue-report.txt"
msgstr "如需报告问题，请附上此输出：big-storage-rescue --doctor > big-storage-rescue-report.txt"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:107
msgid "rsync is not installed, and it does the copying. Install the package rsync."
msgstr "未安装 rsync，而复制工作由它完成。请安装 rsync 软件包。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:108
msgid "A path has a line break in its name. It cannot be handled safely."
msgstr "某个路径的名称中含有换行符，无法安全处理。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:109
msgid "The source folder does not exist or cannot be read."
msgstr "源文件夹不存在或无法读取。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:110
msgid "The source did not answer in time. The drive may be stuck on a damaged area: wait, or unplug it and try again."
msgstr "源未及时响应。驱动器可能卡在某个损坏区域：请等待，或拔下驱动器后重试。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:111
msgid "A selected item is outside the source folder."
msgstr "某个选定的项目位于源文件夹之外。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:112
msgid "A selected item does not exist in the source folder."
msgstr "某个选定的项目在源文件夹中不存在。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:113
msgid "The source and the destination are the same folder."
msgstr "源和目标是同一个文件夹。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:114
msgid "The destination is inside the source. The copy would copy itself."
msgstr "目标位于源之中，复制时会把自身也复制进去。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:115
msgid "The source is inside the destination, which could overwrite the source."
msgstr "源位于目标之中，这可能会覆盖源。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:116
msgid "The source and the destination are on the same filesystem. A copy there does not protect the data."
msgstr "源和目标位于同一个文件系统上。复制到那里无法保护数据。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:117
msgid "The destination is on the same physical disk as the source. If that disk fails, both are lost. To accept that, allow it explicitly."
msgstr "目标与源位于同一块物理磁盘上。如果该磁盘损坏，两者都会丢失。如果接受这一风险，请明确允许。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:118
msgid "The destination folder could not be created."
msgstr "无法创建目标文件夹。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:119
msgid "The destination is read-only."
msgstr "目标是只读的。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:120
msgid "You do not have permission to write to the destination."
msgstr "您没有写入目标的权限。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:121
msgid "The destination did not answer in time."
msgstr "目标未及时响应。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:122
msgid "The destination is on a drive with critical alerts. To accept that, allow it explicitly."
msgstr "目标所在的驱动器有严重警报。如果接受这一风险，请明确允许。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:123
msgid "This drive is at risk and is mounted with writing enabled. Mount it read-only first, so that nothing changes it during the copy. To accept the risk, allow it explicitly."
msgstr "此驱动器存在风险，且以可写方式挂载。请先以只读方式挂载，以免复制期间有任何东西更改它。如果接受这一风险，请明确允许。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:124
msgid "There is not enough free space at the destination."
msgstr "目标的可用空间不足。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:125 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:479
msgid "GNU ddrescue is not installed (package ddrescue). It makes the disk image."
msgstr "未安装 GNU ddrescue（ddrescue 软件包），磁盘映像由它制作。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:126 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1024
msgid "PhotoRec is not installed (package testdisk)."
msgstr "未安装 PhotoRec（testdisk 软件包）。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:127 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:723
msgid "TestDisk is not installed (package testdisk)."
msgstr "未安装 TestDisk（testdisk 软件包）。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:128 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:478 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:778 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:627
msgid "Permission was not granted."
msgstr "未获得权限。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:129 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:771
msgid "Stopped. Nothing was changed on the disk."
msgstr "已停止。磁盘上没有任何改动。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:130 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1031
msgid "This device cannot be read by your user. Make a disk image first (big-storage-rescue --cli image), and search in the image: it also spares the disk."
msgstr "您的用户无法读取此设备。请先制作磁盘映像（big-storage-rescue --cli image），再在映像中搜索：这样也能减轻磁盘的负担。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:131
msgid "The image cannot be stored on the disk being read."
msgstr "映像不能存放在正在读取的磁盘上。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:132
msgid "It cannot be told which disk holds this folder (an overlay, a FUSE folder without a device, or a share of this computer), so the image could end up on the disk being read. Choose a folder on another drive."
msgstr "无法判断此文件夹位于哪块磁盘上（叠加文件系统、没有设备的 FUSE 文件夹，或本机的共享），因此映像可能会存放到正在读取的磁盘上。请选择另一个驱动器上的文件夹。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:133
msgid "An image of another disk already exists in that place. Continuing it would mix the two: choose another name."
msgstr "该位置已存在另一块磁盘的映像。继续写入会将两者混在一起：请选择其他名称。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:134
msgid "A file with this name already exists and is not an image started here. Choose another name."
msgstr "已存在同名文件，且它不是在此处开始制作的映像。请选择其他名称。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:135 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:414 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:626 big-storage-rescue/usr/lib/big-storage-rescue/drive-tui.sh:78
msgid "The device was disconnected or replaced. Nothing was done."
msgstr "设备已被断开或更换。未执行任何操作。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:136 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:405
msgid "This computer has no driver for this filesystem. Installing the right package may solve it."
msgstr "本计算机没有此文件系统的驱动程序。安装相应的软件包可能会解决问题。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:137 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:410
msgid "This volume is encrypted. Unlock it first."
msgstr "此卷已加密。请先将其解锁。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:138 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:411
msgid "This is a part of a larger volume (RAID, LVM or similar), not a filesystem of its own. Its volume must be assembled first."
msgstr "这是一个更大的卷（RAID、LVM 或类似结构）的一部分，本身并不是文件系统。必须先组装其所属的卷。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:139 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:413
msgid "This is swap space, not a place for files."
msgstr "这是交换空间，不是存放文件的地方。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:140
msgid "No filesystem was recognized on it, so its files cannot be listed."
msgstr "未在其上识别到文件系统，因此无法列出其中的文件。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:141
msgid "Choose one of the volumes of this drive to see its files."
msgstr "请选择此驱动器上的一个卷以查看其中的文件。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:142
msgid "This is already a disk image."
msgstr "这已经是一个磁盘映像了。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:143
msgid "Only the files a copy left out can be salvaged."
msgstr "只有复制时遗漏的文件才能保存可读部分。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:144 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1202
msgid "It is still running. Wait for it to finish, or pause it first."
msgstr "它仍在运行。请等待其完成，或先将其暂停。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:145
msgid "GNU ddrescue is not installed (package ddrescue). It reads what can be read of each file."
msgstr "未安装 GNU ddrescue（ddrescue 软件包），每个文件的可读部分由它读取。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:146
msgid "This copy left out no file that can still be read: every file was copied, or the ones left out are no longer in the source."
msgstr "此次复制没有遗漏仍可读取的文件：所有文件都已复制，或者遗漏的文件已不在源中。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:147
msgid "The copy was refused."
msgstr "复制被拒绝。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:166
msgid "The source is mounted with writing enabled. Mounting it read-only is safer."
msgstr "源以可写方式挂载。以只读方式挂载更安全。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:167
msgid "The source drive reported problems. Files that do not advance are set aside so the rest is saved first."
msgstr "源驱动器报告了问题。没有进展的文件会被搁置，以便先保存其余文件。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:168
msgid "The total is not measured on a drive at risk, to avoid extra reads. Progress shows what was copied so far."
msgstr "为避免额外读取，在有风险的驱动器上不测量总量。进度显示的是目前已复制的内容。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:169
msgid "The total is the used space of the volume: an approximation."
msgstr "总量为该卷的已用空间：仅为近似值。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:170
msgid "The destination is FAT32, which cannot store files of 4 GiB or more. Those files will be listed as failed."
msgstr "目标为 FAT32，无法存储 4 GiB 或更大的文件。这些文件将被列为失败。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:171
msgid "The destination does not store Linux permissions. Names and dates are kept, permissions are not."
msgstr "目标不存储 Linux 权限。文件名和日期会保留，权限则不会。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:172
msgid "Some files already exist at the destination with different content. See the option for existing files."
msgstr "目标中已存在部分内容不同的同名文件。请查看已有文件的处理选项。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:173
msgid "This version of rsync cannot sync each file to the disk (it needs 3.2.4 or later). After a power cut, the last files copied should be checked."
msgstr "此版本的 rsync 无法将每个文件同步到磁盘（需要 3.2.4 或更高版本）。断电后，应检查最后复制的几个文件。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:174
msgid "The full check reads every file of the source again. On a drive at risk that is extra wear."
msgstr "完整校验会再次读取源中的每个文件。在有风险的驱动器上，这会造成额外损耗。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:392
msgid "Cannot record a name with a line break: %s"
msgstr "无法记录含有换行符的名称：%s"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:438
msgid "Making the disk image"
msgstr "正在制作磁盘映像"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:439
msgid "Disk image complete"
msgstr "磁盘映像已完成"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:440
msgid "Listing the files"
msgstr "正在列出文件"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:441
msgid "List of files complete"
msgstr "文件列表已完成"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:442
msgid "Searching by content"
msgstr "正在按内容搜索"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:443
msgid "Search complete"
msgstr "搜索已完成"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:444
msgid "Checking whether what was found is whole"
msgstr "正在检查找到的文件是否完整"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:445
msgid "Saving what can be read of each file"
msgstr "正在保存每个文件的可读部分"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:446
msgid "Every file was read completely"
msgstr "所有文件均已完整读取"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:449
msgid "Waiting to start"
msgstr "等待开始"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:450
msgid "Measuring what will be copied"
msgstr "正在统计要复制的内容"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:451
msgid "Copying"
msgstr "正在复制"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:452
msgid "Checking the result"
msgstr "正在校验结果"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:453
msgid "Stopping: waiting for the disk to answer"
msgstr "正在停止：等待磁盘响应"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:454
msgid "Paused"
msgstr "已暂停"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:455
msgid "Completed and checked"
msgstr "已完成并已校验"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:456
msgid "Cancelled"
msgstr "已取消"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:457
msgid "Failed"
msgstr "失败"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:458
msgid "Finished, needs your attention"
msgstr "已完成，需要您注意"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:459
msgid "Interrupted (it can be resumed)"
msgstr "已中断（可以继续）"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:470
msgid "The source drive was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "源驱动器已断开或已卸载。请重新连接并挂载，然后继续。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:471
msgid "The destination was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "目标已断开或已卸载。请重新连接并挂载，然后继续。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:472
msgid "The destination ran out of space. Free some space or choose another place, then resume."
msgstr "目标空间已用完。请释放一些空间或选择其他位置，然后继续。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:473
msgid "%s files were set aside because they did not advance. The drive may be getting worse, so the copy stopped."
msgstr "有 %s 个文件因没有进展而被搁置。驱动器的状况可能正在恶化，因此复制已停止。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:474
msgid "Some files were not copied. See the list below."
msgstr "部分文件未能复制。请查看下面的列表。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:475
msgid "The check found differences between source and destination."
msgstr "校验发现源和目标之间存在差异。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:476
msgid "Everything was copied, but the check did not finish: it was cancelled or failed."
msgstr "所有内容均已复制，但校验没有完成：已被取消或失败。"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:477
msgid "rsync stopped with an error. See the log."
msgstr "rsync 因错误而停止。请查看日志。"

