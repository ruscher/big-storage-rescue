msgstr "Можно выбрать несколько вариантов. Если не уверены, оставьте «Все типы»."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:552 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1006
msgid "All types"
msgstr "Все типы"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:611
msgid "This drive reported problems: every extra read wears it. Nothing starts without you."
msgstr "Этот диск сообщил о проблемах: каждое лишнее чтение изнашивает его. Без вашего согласия ничего не начнётся."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:616
msgid "You chose the whole drive. Copying files and the quick analysis work with the files of a volume."
msgstr "Вы выбрали весь диск. Копирование файлов и быстрый анализ работают с файлами тома."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:617
#, python-format
msgid "Use the volume %s"
msgstr "Использовать том %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:627
msgid "Advanced"
msgstr "Дополнительно"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:627
