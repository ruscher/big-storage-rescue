msgstr "Что копировать"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:636 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1004
msgid "Everything"
msgstr "Всё"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:636
