msgstr "Восстановленные"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:123
msgid "Recovered files"
msgstr "Восстановленные файлы"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:131
msgid "Files found"
msgstr "Найденные файлы"

