msgstr[0] "Отмечен %d элемент. Общий объём будет измерен на следующих шагах."
msgstr[1] "Отмечено %d элемента. Общий объём будет измерен на следующих шагах."
msgstr[2] "Отмечено %d элементов. Общий объём будет измерен на следующих шагах."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:304
msgid "Mark what to copy. A marked folder takes everything inside. Only the folders you open are read."
msgstr "Отметьте, что скопировать. Отмеченная папка включает всё своё содержимое. Читаются только те папки, которые вы открываете."

