msgstr "Безопасно извлечь (показывает, что занимает устройство)"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:21
msgid "Check the health of this drive"
msgstr "Проверить здоровье этого диска"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:26
msgid "Recover files from this drive…"
msgstr "Восстановить файлы с этого диска…"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:31
