#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:22
msgid "Usage: big-storage-rescue [OPTION] [DEVICE|FOLDER]"
msgstr "Использование: big-storage-rescue [ПАРАМЕТР] [УСТРОЙСТВО|ПАПКА]"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:25
msgid "(none)"
msgstr "(нет)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:25
msgid "the application in a graphical session, the manager in a terminal"
msgstr "приложение в графическом сеансе, менеджер в терминале"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:26
msgid "the application: drives, health and file rescue"
msgstr "приложение: диски, их здоровье и спасение файлов"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:27
msgid "the same application, opened on the health of the drive"
msgstr "то же приложение, сразу на странице здоровья диска"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:28
msgid "the same application, opened on the recovery of files from it"
msgstr "то же приложение, сразу на странице восстановления файлов с него"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:29
msgid "drive manager and file rescue in the terminal (big-storage-rescue --cli --help)"
msgstr "менеджер дисков и спасение файлов в терминале (big-storage-rescue --cli --help)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:30
msgid "storage overview, or details of one device (a whole disk: drive errors)"
msgstr "обзор накопителей или сведения об одном устройстве (для целого диска: ошибки диска)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:31
msgid "show what keeps a device busy"
msgstr "показать, что занимает устройство"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:32
msgid "unmount one filesystem safely"
msgstr "безопасно размонтировать одну файловую систему"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:33
msgid "unmount every filesystem of the drive and power it off"
msgstr "размонтировать все файловые системы диска и выключить его питание"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:34
msgid "with --safe-remove: unmount everything, do not power it off"
msgstr "с --safe-remove: размонтировать всё, но не выключать питание"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:35
msgid "offer to close the programs that keep it busy"
msgstr "предложить закрыть программы, которые занимают устройство"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:36
msgid "do not ask before closing them or stopping services (scripts)"
msgstr "не спрашивать перед закрытием программ или остановкой служб (для скриптов)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:37
msgid "graphical diagnosis of one device (Dolphin menu)"
msgstr "графическая диагностика одного устройства (меню Dolphin)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:38
msgid "graphical safe removal (Dolphin menu)"
msgstr "графическое безопасное извлечение (меню Dolphin)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:39
msgid "session service: warn about read-only devices"
msgstr "служба сеанса: предупреждать об устройствах только для чтения"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:40
msgid "bring the copies and settings of Big-Mount 2.x over (also done on start)"
msgstr "перенести копии и настройки Big-Mount 2.x (выполняется и при запуске)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:41
msgid "check the installation and the storage stack (for bug reports)"
msgstr "проверить установку и подсистему хранения (для отчётов об ошибках)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:42
msgid "show the version and the source revision"
msgstr "показать версию и ревизию исходного кода"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:43
msgid "show this help"
msgstr "показать эту справку"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:44
msgid "TARGET is a device (/dev/sdb1) or any folder inside a mounted device."
msgstr "TARGET — это устройство (/dev/sdb1) или любая папка на смонтированном устройстве."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:45
msgid "Machine-readable output: big-storage-rescue --cli COMMAND --json"
msgstr "Машиночитаемый вывод: big-storage-rescue --cli КОМАНДА --json"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:123 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:849 big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:441 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:237 big-storage-rescue/usr/lib/big-storage-rescue/migrate.sh:190
msgid "big-storage-rescue: unknown option '%s' (see big-storage-rescue --help)"
msgstr "big-storage-rescue: неизвестный параметр «%s» (см. big-storage-rescue --help)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:141
msgid "The jobs of Big-Mount 2.x are not brought over by a dry run. To see them here, run first: big-storage-rescue --migrate-state"
msgstr "Пробный запуск не переносит задания Big-Mount 2.x. Чтобы увидеть их здесь, сначала выполните: big-storage-rescue --migrate-state"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:157 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1194
msgid "Device ready"
msgstr "Устройство готово"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:158
msgid "You can read and write files on this device."
msgstr "Вы можете читать и записывать файлы на этом устройстве."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:161
msgid "Device not mounted"
msgstr "Устройство не смонтировано"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:162
msgid "The filesystem is not mounted at the moment."
msgstr "Файловая система сейчас не смонтирована."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:163
msgid "Open the device in the file manager (Dolphin) to mount it."
msgstr "Чтобы смонтировать устройство, откройте его в файловом менеджере (Dolphin)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:166 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:172 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:179 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:201
msgid "Read-only device"
msgstr "Устройство только для чтения"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:167
msgid "The device itself is write-protected, so no system can write to it."
msgstr "Само устройство защищено от записи, поэтому никакая система не может на него записывать."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:168
msgid "SD cards and some USB drives have a small lock switch on the side. Remove the device, move the switch to the unlocked position and connect it again."
msgstr "У SD-карт и некоторых USB-накопителей сбоку есть маленький переключатель блокировки. Извлеките устройство, переведите переключатель в положение без блокировки и подключите устройство снова."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:169
msgid "If there is no switch, the device may have locked itself because of wear. Copy your files to another place as soon as possible."
msgstr "Если переключателя нет, устройство могло заблокироваться само из-за износа. Как можно скорее скопируйте свои файлы в другое место."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:173
msgid "This kind of filesystem cannot be written on Linux with the driver in use."
msgstr "Файловая система этого типа недоступна для записи в Linux с используемым драйвером."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:174
msgid "CDs, DVDs and disk images (ISO, SquashFS) are read-only by nature."
msgstr "CD, DVD и образы дисков (ISO, SquashFS) по своей природе доступны только для чтения."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:175
msgid "Drives formatted on a Mac (HFS+ with journaling, APFS) can only be read on Linux."
msgstr "Диски, отформатированные на Mac (HFS+ с журналированием, APFS), в Linux можно только читать."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:176
msgid "To write to it, copy the files elsewhere and format the device with a filesystem such as exFAT. Formatting erases everything on it."
msgstr "Чтобы записывать на устройство, скопируйте файлы в другое место и отформатируйте его в файловую систему, например exFAT. Форматирование стирает всё, что на нём есть."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:180
msgid "Windows did not close this NTFS partition properly (hibernation, Fast Startup or an interrupted shutdown). Writing to it now could damage files."
msgstr "Windows неправильно закрыла этот раздел NTFS (гибернация, быстрый запуск или прерванное завершение работы). Запись на него сейчас может повредить файлы."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:181
msgid "Start Windows and shut it down completely: hold the Shift key while you click Shut down."
msgstr "Запустите Windows и полностью завершите её работу: удерживайте клавишу Shift, нажимая «Завершение работы»."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:182
msgid "To avoid this in the future, disable Fast Startup in Windows: Control Panel > Power Options > Choose what the power buttons do."
msgstr "Чтобы это не повторялось, отключите в Windows быстрый запуск: Панель управления > Электропитание > Действия кнопок питания."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:183
msgid "If it still happens, check the partition in Windows: open the Command Prompt as administrator and run chkdsk with the /f option for that drive letter."
msgstr "Если это повторится, проверьте раздел в Windows: откройте командную строку от имени администратора и выполните chkdsk с параметром /f для буквы этого диска."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:184
msgid "Big Storage Rescue never repairs NTFS by itself, because the repair tools available on Linux may discard data that Windows still needs."
msgstr "Big Storage Rescue никогда не исправляет NTFS самостоятельно, потому что доступные в Linux средства восстановления могут удалить данные, которые ещё нужны Windows."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:187
msgid "The filesystem needs attention"
msgstr "Файловая система требует внимания"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:188
msgid "The system found errors in the filesystem and stopped writing to it to protect your files."
msgstr "Система обнаружила ошибки в файловой системе и прекратила запись на неё, чтобы защитить ваши файлы."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:189
msgid "First copy your important files to another place."
msgstr "Сначала скопируйте важные файлы в другое место."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:190
msgid "Then check the filesystem with the device unmounted, for example with KDE Partition Manager (Check)."
msgstr "Затем проверьте файловую систему на размонтированном устройстве, например в KDE Partition Manager (действие «Проверить»)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:191
msgid "Do not write to the device until it has been checked."
msgstr "Не записывайте на устройство, пока оно не будет проверено."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:194
msgid "The device has read or write errors"
msgstr "На устройстве есть ошибки чтения или записи"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:195
msgid "The device reported read or write errors. This is usually a bad cable, a weak USB port or a failing drive."
msgstr "Устройство сообщило об ошибках чтения или записи. Обычно причина в плохом кабеле, слабом порте USB или неисправном диске."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:196 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:974
msgid "Copy your important files to another place as soon as possible."
msgstr "Как можно скорее скопируйте важные файлы в другое место."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:197
msgid "Try another cable and connect the device directly to the computer, without a hub."
msgstr "Попробуйте другой кабель и подключите устройство напрямую к компьютеру, без концентратора."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:198
msgid "Check the health of the drive in KDE Partition Manager (SMART status)."
msgstr "Проверьте здоровье диска в KDE Partition Manager (состояние SMART)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:202
msgid "The filesystem was mounted read-only, but no problem was found with it."
msgstr "Файловая система была смонтирована только для чтения, но проблем с ней не обнаружено."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:203
msgid "Mount it again with writing enabled."
msgstr "Смонтируйте её снова с разрешённой записью."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:204
msgid "Mount again with writing"
msgstr "Смонтировать снова с записью"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:205
msgid "The device will be unmounted and mounted again with writing enabled. Nothing on it is changed. Programs using it must be closed first."
msgstr "Устройство будет размонтировано и снова смонтировано с разрешённой записью. Данные на нём не изменятся. Программы, которые его используют, нужно сначала закрыть."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:208 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:216 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:221 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:235
msgid "No permission to write"
msgstr "Нет прав на запись"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:209
msgid "The device accepts writing, but its main folder belongs to another user and you are not allowed to change it."
msgstr "Устройство допускает запись, но его главная папка принадлежит другому пользователю, и вам не разрешено её изменять."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:210
msgid "You can become the owner of the main folder. Only that folder changes: the files and folders inside it keep their owners."
msgstr "Вы можете стать владельцем главной папки. Изменится только эта папка: файлы и папки внутри неё сохранят своих владельцев."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:211
msgid "This is the usual fix for drives formatted with a Linux filesystem (ext4, Btrfs, XFS)."
msgstr "Это обычное решение для дисков с файловой системой Linux (ext4, Btrfs, XFS)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:212
msgid "Become owner of the main folder"
msgstr "Стать владельцем главной папки"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:213
msgid "The main folder of the device will belong to you (not recursive: the files and folders inside keep their owners). The administrator password may be requested."
msgstr "Главная папка устройства будет принадлежать вам (не рекурсивно: файлы и папки внутри сохранят своих владельцев). Может потребоваться пароль администратора."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:217
msgid "This partition contains an operating system. Its folders belong to that system and must keep their owners."
msgstr "На этом разделе установлена операционная система. Её папки принадлежат этой системе и должны сохранить своих владельцев."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:218
msgid "Save your files in a folder that belongs to you, for example your home folder on that system."
msgstr "Сохраняйте свои файлы в папке, которая принадлежит вам, например в вашей домашней папке в той системе."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:222
msgid "This folder belongs to %s, and only its owner can create or change files in it."
msgstr "Эта папка принадлежит пользователю %s, и только владелец может создавать или изменять в ней файлы."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:223
msgid "Save your files in a folder of your own, for example in your home folder."
msgstr "Сохраняйте свои файлы в собственной папке, например в домашней папке."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:226
msgid "System partition"
msgstr "Системный раздел"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:227
msgid "This partition holds the operating system that is running now. Only the system and administrators write here."
msgstr "На этом разделе находится операционная система, которая сейчас работает. Записывать сюда могут только система и администраторы."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:228
msgid "Save your files in your home folder."
msgstr "Сохраняйте свои файлы в домашней папке."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:231
msgid "Swap space"
msgstr "Пространство подкачки"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:232
msgid "This partition is used as swap space (virtual memory), not to store files."
msgstr "Этот раздел используется как пространство подкачки (виртуальная память), а не для хранения файлов."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:236
msgid "The device was mounted for another user, so only that user can write to it."
msgstr "Устройство было смонтировано для другого пользователя, поэтому записывать на него может только этот пользователь."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:237
msgid "Unmount it and open it again from the file manager while you are logged in."
msgstr "Размонтируйте устройство и откройте его снова из файлового менеджера, войдя в систему под своей учётной записью."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:239
msgid "This internal partition is mounted by Big-Mount at boot. An administrator can choose who may write to it with PERMISSIONS in /etc/big-mount.conf."
msgstr "Этот внутренний раздел монтируется службой Big-Mount при загрузке. Администратор может выбрать, кому разрешена запись, с помощью параметра PERMISSIONS в /etc/big-mount.conf."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:241
msgid "Mount again for my user"
msgstr "Смонтировать снова для моего пользователя"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:242
msgid "The device will be unmounted and mounted again for your user. Nothing on it is changed. Programs using it must be closed first."
msgstr "Устройство будет размонтировано и снова смонтировано для вашего пользователя. Данные на нём не изменятся. Программы, которые его используют, нужно сначала закрыть."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:245
msgid "Unknown state"
msgstr "Неизвестное состояние"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:246
msgid "The state of this device could not be determined."
msgstr "Не удалось определить состояние этого устройства."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:255 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:930 big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:57
msgid "unknown"
msgstr "неизвестно"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:286
msgid "system"
msgstr "система"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:291
msgid "other"
msgstr "другое"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:304 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:602 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:314 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:252
msgid "Device"
msgstr "Устройство"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:305 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:603 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:266
msgid "Filesystem"
msgstr "Файловая система"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:307 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:604 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:270
msgid "Mounted at"
msgstr "Точка монтирования"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:308
msgid "Folder"
msgstr "Папка"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:310
msgid "Writable, but not by your user"
msgstr "Доступно для записи, но не вашему пользователю"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:310 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:269
msgid "Status"
msgstr "Состояние"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:314 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:973
msgid "How to solve:"
msgstr "Как исправить:"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:318
msgid "Attention: the filesystem has recorded errors. Copy important files elsewhere and check it soon."
msgstr "Внимание: в файловой системе зарегистрированы ошибки. Скопируйте важные файлы в другое место и в ближайшее время проверьте её."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:321
msgid "Attention: the drive that holds this device reported errors since the computer was started. Copy important files elsewhere and check the drive."
msgstr "Внимание: диск, на котором находится это устройство, сообщал об ошибках с момента включения компьютера. Скопируйте важные файлы в другое место и проверьте диск."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:394
msgid "To see the errors of the drive: big-storage-rescue --diagnose %s"
msgstr "Чтобы увидеть ошибки диска: big-storage-rescue --diagnose %s"

