msgid "Next"
msgstr "Далее"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:367
#, python-format
msgid "Step %(n)d of %(t)d"
msgstr "Шаг %(n)d из %(t)d"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:406
msgid "Look for partitions"
msgstr "Искать разделы"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:434
msgid "The source was unmounted. Nothing was done."
msgstr "Источник был размонтирован. Ничего не сделано."

