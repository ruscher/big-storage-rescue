msgstr "Остановить копирование? Уже скопированные файлы останутся в месте назначения, а копирование можно будет продолжить позже."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/job.py:329
msgid "Stop this work?"
msgstr "Остановить эту работу?"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/job.py:329
msgid "Keep working"
msgstr "Продолжить работу"

