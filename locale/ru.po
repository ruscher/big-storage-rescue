msgstr "Нет доступа к устройству хранения"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1076
msgid "Big Storage Rescue could not identify this storage device. It may have been disconnected or become temporarily unavailable."
msgstr "Big Storage Rescue не удалось определить это устройство хранения. Возможно, оно было отсоединено или временно недоступно."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1077
msgid "If you disconnected it, connect it again and choose Try again."
msgstr "Если вы отсоединили его, подключите снова и выберите «Повторить попытку»."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1078 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1220
msgid "Try again"
msgstr "Повторить попытку"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1078 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1085 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1124 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1126 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1129 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1131 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1140 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1233
