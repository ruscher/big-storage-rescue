msgstr "Запрашивает пароль администратора."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:704 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:829
#, python-format
msgid "Not available: %s"
msgstr "Недоступно: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:717
#, python-format
msgid "Use %s"
msgstr "Использовать %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:719
msgid "Check again"
msgstr "Проверить снова"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:720
