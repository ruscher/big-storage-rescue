msgstr "Только для образа диска, глубокого поиска или потерянных разделов. Чтобы скопировать файлы, выберите том выше."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:480
msgid "The whole drive"
msgstr "Весь диск"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:507
msgid "Image file"
msgstr "Файл образа"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:526
msgid "Checking what can be done…"
msgstr "Проверка возможных действий…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:531
msgid "This source cannot be used"
msgstr "Этот источник нельзя использовать"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:549
