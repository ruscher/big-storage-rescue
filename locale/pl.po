msgstr "Proszę wybrać dysk, aby zobaczyć jego pliki, sprawdzić jego stan zdrowia lub odzyskać dane."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:164
msgid "Search by name, model, label or folder"
msgstr "Wyszukiwanie według nazwy, modelu, etykiety lub katalogu"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:165
msgid "Search drives"
msgstr "Wyszukiwanie dysków"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:172
msgid "List"
msgstr "Lista"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:172
msgid "Grid"
msgstr "Siatka"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:188
msgid "Looking at what is connected…"
msgstr "Sprawdzanie, co jest podłączone…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:190
msgid "Connect a drive and it appears here by itself."
msgstr "Po podłączeniu dysk pojawi się tutaj automatycznie."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:228
#, python-format
msgid "%s reported serious problems. Copy your files to another drive before trying any repair."
msgstr "%s zgłosił poważne problemy. Przed jakąkolwiek próbą naprawy należy skopiować pliki na inny dysk."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:247
#, python-format
msgid "No drive matches “%s”"
msgstr "Żaden dysk nie pasuje do „%s”"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/overview.py:248
msgid "Search by name, model, volume label, folder or health."
msgstr "Można wyszukiwać według nazwy, modelu, etykiety woluminu, katalogu lub stanu zdrowia."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:19
msgid "Where should files be recovered from?"
msgstr "Skąd odzyskać pliki?"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:20
msgid "What are you looking for?"
msgstr "Czego szukać?"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:21
msgid "How should they be looked for?"
msgstr "Jak ich szukać?"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:23
msgid "Where should they be saved?"
msgstr "Gdzie je zapisać?"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:24
msgid "Check and start"
msgstr "Sprawdzenie i rozpoczęcie"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:28
msgid "Quick analysis"
msgstr "Szybka analiza"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:29
msgid "Lists the files that exist on the volume, by type, and you choose what to copy. Deleted files are not on this list."
msgstr "Wyświetla pliki istniejące na woluminie według typu, a następnie można wybrać, co skopiować. Usuniętych plików nie ma na tej liście."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:31
msgid "Copy files directly"
msgstr "Bezpośrednie kopiowanie plików"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:32
msgid "Copies everything, or the folders you choose, with their names. It does not filter by type, and it does not go through what you leave out."
msgstr "Kopiuje wszystko lub wybrane katalogi wraz z nazwami. Nie filtruje według typu i nie przechodzi przez to, co zostało pominięte."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:34
msgid "Deep analysis"
msgstr "Głęboka analiza"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:35
msgid "Searches every sector for files by their content. It can find what no longer appears, but names and folders are lost, some files come out incomplete and nothing is guaranteed."
msgstr "Przeszukuje każdy sektor w poszukiwaniu plików według ich zawartości. Może znaleźć to, czego już nie widać, ale nazwy i katalogi zostają utracone, niektóre pliki są niekompletne i nic nie jest gwarantowane."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:37
msgid "Make a disk image only"
msgstr "Tylko utworzenie obrazu dysku"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:38
msgid "Copies the whole device to a file on another disk with GNU ddrescue, keeping a map so it can resume and never reads a good area twice."
msgstr "Kopiuje całe urządzenie do pliku na innym dysku za pomocą GNU ddrescue, prowadząc mapę, dzięki której może wznowić pracę i nigdy nie odczytuje dobrego obszaru dwukrotnie."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:40 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1076
msgid "Look for lost partitions"
msgstr "Wyszukiwanie utraconych partycji"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:41 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1083
msgid "TestDisk reads the partition table and analyzes the disk. It only shows what it finds: nothing is written."
msgstr "TestDisk odczytuje tablicę partycji i analizuje dysk. Tylko pokazuje, co znajdzie: niczego nie zapisuje."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:47
msgid "Recovered"
msgstr "Odzyskane"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:123
msgid "Recovered files"
msgstr "Odzyskane pliki"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:131
msgid "Files found"
msgstr "Znalezione pliki"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:268
#, python-format
msgid "%d item marked. The total is measured in the next steps."
msgid_plural "%d items marked. The total is measured in the next steps."
msgstr[0] "%d element zaznaczony. Suma zostanie zmierzona w kolejnych krokach."
msgstr[1] "%d elementy zaznaczone. Suma zostanie zmierzona w kolejnych krokach."
msgstr[2] "%d elementów zaznaczonych. Suma zostanie zmierzona w kolejnych krokach."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:304
msgid "Mark what to copy. A marked folder takes everything inside. Only the folders you open are read."
msgstr "Proszę zaznaczyć, co skopiować. Zaznaczony katalog obejmuje całą swoją zawartość. Odczytywane są tylko otwierane katalogi."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:327 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:397
msgid "Next"
msgstr "Dalej"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:367
#, python-format
msgid "Step %(n)d of %(t)d"
msgstr "Krok %(n)d z %(t)d"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:406
msgid "Look for partitions"
msgstr "Wyszukaj partycje"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:434
msgid "The source was unmounted. Nothing was done."
msgstr "Źródło zostało odmontowane. Nic nie zrobiono."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:446
msgid "Choose the drive or the volume. Nothing is read or changed yet."
msgstr "Proszę wybrać dysk lub wolumin. Na razie nic nie jest odczytywane ani zmieniane."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:451
msgid "A disk image"
msgstr "Obraz dysku"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:452 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:455
msgid "A disk image saved before"
msgstr "Wcześniej zapisany obraz dysku"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:452
msgid "Searching it does not touch any disk."
msgstr "Przeszukiwanie go nie dotyka żadnego dysku."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:477
msgid "For an image or a deep search: every sector, whatever the volumes."
msgstr "Dla obrazu lub głębokiego wyszukiwania: każdy sektor, niezależnie od woluminów."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:479
msgid "Only for a disk image, a deep search or lost partitions. To copy files, choose a volume above."
msgstr "Tylko dla obrazu dysku, głębokiego wyszukiwania lub utraconych partycji. Aby skopiować pliki, należy wybrać wolumin powyżej."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:480
msgid "The whole drive"
msgstr "Cały dysk"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:507
msgid "Image file"
msgstr "Plik obrazu"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:526
msgid "Checking what can be done…"
msgstr "Sprawdzanie, co można zrobić…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:531
msgid "This source cannot be used"
msgstr "Nie można użyć tego źródła"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:549
msgid "You can choose more than one. If you are not sure, leave All."
msgstr "Można wybrać więcej niż jeden. W razie wątpliwości należy pozostawić „Wszystkie typy”."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:552 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1006
msgid "All types"
msgstr "Wszystkie typy"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:611
msgid "This drive reported problems: every extra read wears it. Nothing starts without you."
msgstr "Ten dysk zgłosił problemy: każdy dodatkowy odczyt go zużywa. Nic nie rozpocznie się bez zgody użytkownika."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:616
msgid "You chose the whole drive. Copying files and the quick analysis work with the files of a volume."
msgstr "Wybrano cały dysk. Kopiowanie plików i szybka analiza działają z plikami woluminu."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:617
#, python-format
msgid "Use the volume %s"
msgstr "Użyj woluminu %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:627
msgid "Advanced"
msgstr "Zaawansowane"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:627
msgid "Tools that work with the whole disk"
msgstr "Narzędzia działające z całym dyskiem"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:634
msgid "What to copy"
msgstr "Co skopiować"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:636 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1004
msgid "Everything"
msgstr "Wszystko"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:636
msgid "All the files of this volume."
msgstr "Wszystkie pliki tego woluminu."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:637
msgid "Only what you mark. Recommended on a drive with problems: the most important first."
msgstr "Tylko to, co zostanie zaznaczone. Zalecane na dysku z problemami: najpierw to, co najważniejsze."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:702
msgid "It asks for the administrator password."
msgstr "Wymaga hasła administratora."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:704 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:829
#, python-format
msgid "Not available: %s"
msgstr "Niedostępne: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:717
#, python-format
msgid "Use %s"
msgstr "Użyj: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:719
msgid "Check again"
msgstr "Sprawdź ponownie"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:720
msgid "After installing the package, check again without leaving the assistant."
msgstr "Po zainstalowaniu pakietu można sprawdzić ponownie bez opuszczania asystenta."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:722
msgid "Recommended"
msgstr "Zalecane"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:744
#, python-format
msgid "First a disk image is made, which needs free space elsewhere as large as the source (%s). Then the image is searched, and the disk rests."
msgstr "Najpierw tworzony jest obraz dysku, który wymaga w innym miejscu wolnego miejsca równego rozmiarowi źródła (%s). Następnie przeszukiwany jest obraz, a dysk odpoczywa."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:746
msgid "A direct copy does not filter by type. To choose by type, use the quick analysis."
msgstr "Bezpośrednie kopiowanie nie filtruje według typu. Aby wybierać według typu, należy użyć szybkiej analizy."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:788
#, python-format
msgid "From: %s"
msgstr "Źródło: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:790
msgid "Never on the same physical disk as the source. If that disk fails, both are lost."
msgstr "Nigdy na tym samym dysku fizycznym co źródło. Jeśli ten dysk ulegnie awarii, oba zostaną utracone."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:791
msgid "Places on another disk"
msgstr "Miejsca na innym dysku"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:792
msgid "Looking for places…"
msgstr "Wyszukiwanie miejsc…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:795 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:668
msgid "Choose another folder…"
msgstr "Wybierz inny katalog…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:845
msgid "No other disk is mounted. Connect one, or choose a folder."
msgstr "Nie zamontowano żadnego innego dysku. Należy podłączyć dysk lub wybrać katalog."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:866
msgid "Checking this place…"
msgstr "Sprawdzanie tego miejsca…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:872
msgid "The check could not be done."
msgstr "Nie można przeprowadzić sprawdzenia."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:876
msgid "Everything can be saved here."
msgstr "Wszystko można tutaj zapisać."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:878
#, python-format
msgid "It can be saved here: %s free."
msgstr "Można tutaj zapisać: wolne %s."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:881
msgid "It cannot be saved here."
msgstr "Nie można tutaj zapisać."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:938
msgid "Checking the source and the destination…"
msgstr "Sprawdzanie źródła i miejsca docelowego…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:947
msgid "It cannot be started."
msgstr "Nie można rozpocząć."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:967
msgid "Method"
msgstr "Metoda"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:970
msgid "What"
msgstr "Co"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:973
msgid "Space it will use"
msgstr "Miejsce, które zostanie zajęte"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:975 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:977
msgid "To copy"
msgstr "Do skopiowania"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:975
#, python-format
msgid "%(files)s files, %(size)s"
msgstr "Pliki: %(files)s, %(size)s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:979
msgid "Free at the destination"
msgstr "Wolne w miejscu docelowym"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:981
msgid "Already there, with different content"
msgstr "Już istniejące, z inną zawartością"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:984
msgid "Your files will be copied with their names. Nothing is written to the source."
msgstr "Pliki zostaną skopiowane wraz z nazwami. Nic nie zostanie zapisane w źródle."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:985
msgid "First a list of what exists is made. Then you choose what to copy. Nothing is written to the source."
msgstr "Najpierw tworzona jest lista istniejących plików. Następnie można wybrać, co skopiować. Nic nie zostanie zapisane w źródle."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:986
msgid "Files will be searched for by their content. Names and folders are lost, some files may come out incomplete, and finding nothing is possible. Nothing is written to the source."
msgstr "Pliki będą wyszukiwane według zawartości. Nazwy i katalogi zostaną utracone, niektóre pliki mogą być niekompletne i możliwe jest, że nic nie zostanie znalezione. Nic nie zostanie zapisane w źródle."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:987
msgid "The disk is read once, into a file. Nothing is written to it."
msgstr "Dysk zostanie odczytany raz, do pliku. Nic nie zostanie na nim zapisane."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:992
msgid "After the image, the search needs your confirmation. It can also be started later."
msgstr "Po utworzeniu obrazu wyszukiwanie wymaga potwierdzenia. Można je też rozpocząć później."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:994
msgid "Good to know"
msgstr "Warto wiedzieć"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1004
#, python-format
msgid "%d item you marked"
msgid_plural "%d items you marked"
msgstr[0] "%d zaznaczony element"
msgstr[1] "%d zaznaczone elementy"
msgstr[2] "%d zaznaczonych elementów"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1014
msgid "If a file already exists"
msgstr "Jeśli plik już istnieje"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1019
msgid "Check the result"
msgstr "Sprawdzanie wyniku"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Podstawowe: rsync potwierdza każdy plik podczas kopiowania"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Names, sizes and dates compared at the end"
msgstr "Porównanie nazw, rozmiarów i dat na końcu"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1022
msgid "Content compared at the end (reads the source again)"
msgstr "Porównanie zawartości na końcu (ponownie odczytuje źródło)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1026
msgid "Set aside a stuck file after (seconds)"
msgstr "Odkładanie zablokowanego pliku po czasie (w sekundach)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1028
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "Plik, którego kopiowanie nie postępuje przez ten czas, zostaje odłożony, aby najpierw zapisać pozostałe. 0: nigdy."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1032
msgid "Limit the reading speed (kB/s)"
msgstr "Ograniczenie prędkości odczytu (kB/s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1034
msgid "0: no limit"
msgstr "0: bez ograniczenia"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1045
msgid "Starting…"
msgstr "Rozpoczynanie…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1084
msgid "Read the partition table"
msgstr "Odczytaj tablicę partycji"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1085
msgid "Analyze the whole disk"
msgstr "Przeanalizuj cały dysk"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1086
msgid "It reads all of the disk. On a drive with problems this is extra wear."
msgstr "Odczytuje cały dysk. Na dysku z problemami oznacza to dodatkowe zużycie."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1089
msgid "This drive reported problems: analyzing all of it is extra wear. A disk image first spares it."
msgstr "Ten dysk zgłosił problemy: analizowanie go w całości oznacza dodatkowe zużycie. Wcześniejsze utworzenie obrazu dysku go oszczędza."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1111
msgid "Stopping…"
msgstr "Zatrzymywanie…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1118
msgid "Volumes this drive already has"
msgstr "Istniejące woluminy tego dysku"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1119
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "Nie są utracone. Aby odzyskać ich pliki, kopiowanie jest szybsze i mniej obciąża dysk niż jakakolwiek analiza."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1124
msgid "Recover its files"
msgstr "Odzyskaj jego pliki"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1136
msgid "Looking for partitions…"
msgstr "Wyszukiwanie partycji…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1140
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "TestDisk nie informuje o postępie, więc nie ma wartości procentowej. Analiza całego dysku odczytuje go w całości i może trwać godzinami; w tym czasie dysku nie można używać do niczego innego."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1151
#, python-format
msgid "Elapsed: %s"
msgstr "Upłynęło: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1171
msgid "The search failed."
msgstr "Wyszukiwanie się nie powiodło."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1174
msgid "What TestDisk found"
msgstr "Co znalazł TestDisk"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1180
msgid "Big Storage Rescue does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "Big Storage Rescue celowo nie zapisuje ponownie tablic partycji: błąd w tym miejscu może spowodować utratę wszystkiego. Obraz dysku lub wyszukiwanie według zawartości odzyskuje pliki bez tego ryzyka."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1182
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "Analiza nie rozpoznała żadnej partycji. Nie dowodzi to, że nie ma danych: wyszukiwanie według zawartości nadal może znaleźć pliki."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1184
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "Tablica partycji jest pusta lub nieczytelna. Analiza całego dysku może znaleźć to, czego tablica już nie wymienia."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:256
msgid "This picture cannot be shown"
msgstr "Nie można wyświetlić tego obrazka"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:257
msgid "It may be incomplete. That is common with files found by content."
msgstr "Może być niekompletny. To częste w przypadku plików znalezionych według zawartości."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:302 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:303
msgid "Search by name"
msgstr "Wyszukiwanie według nazwy"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "As found"
msgstr "W kolejności znalezienia"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "Largest first"
msgstr "Od największych"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "By name"
msgstr "Według nazwy"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:306
msgid "Order"
msgstr "Kolejność"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:320
msgid "Name"
msgstr "Nazwa"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:324
msgid "Date"
msgstr "Data"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:329
msgid "Reading the list…"
msgstr "Odczytywanie listy…"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:331
msgid "Nothing to show"
msgstr "Nie ma nic do wyświetlenia"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:332
msgid "No file matches what you asked for."
msgstr "Żaden plik nie pasuje do podanych kryteriów."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:339
msgid "Recover selected"
msgstr "Odzyskaj zaznaczone"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:341
msgid "Select all shown"
msgstr "Zaznacz wszystkie wyświetlane"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:342
msgid "Clear selection"
msgstr "Wyczyść zaznaczenie"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:349 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:680
msgid "Save report"
msgstr "Zapisz raport"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:350
msgid "Try another method"
msgstr "Spróbuj innej metody"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:386
msgid "Candidates found by content. They are saved in the destination folder, without their names and folders, and some may be incomplete. Check them before deleting anything."
msgstr "Potencjalne pliki znalezione według zawartości. Są zapisane w katalogu docelowym bez nazw i katalogów, a niektóre mogą być niekompletne. Przed usunięciem czegokolwiek należy je sprawdzić."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:388
#, python-format
msgid "By their structure: %(whole)d look whole, %(short)d are cut short, %(bad)d are damaged and %(other)d could not be checked. Whole does not prove every byte is right: open the files that matter."
msgstr "Według struktury: wyglądające na całe: %(whole)d, ucięte: %(short)d, uszkodzone: %(bad)d, niesprawdzone: %(other)d. „Całe” nie dowodzi, że każdy bajt jest poprawny: należy otworzyć ważne pliki."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:391
msgid "Copy selected to another folder"
msgstr "Skopiuj zaznaczone do innego katalogu"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:393
msgid "These files exist on the volume and have not been copied yet. Deleted files are not on this list."
msgstr "Te pliki istnieją na woluminie i nie zostały jeszcze skopiowane. Usuniętych plików nie ma na tej liście."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:406
#, python-format
msgid "All (%d)"
msgstr "Wszystkie (%d)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:427
msgid "The list could not be read."
msgstr "Nie można odczytać listy."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:525
#, python-format
msgid "%(shown)d shown, %(sel)d selected (%(size)s)"
msgstr "Wyświetlane: %(shown)d, zaznaczone: %(sel)d (%(size)s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:542
msgid "Select"
msgstr "Zaznacz"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:567
msgid "Preview"
msgstr "Podgląd"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:638
msgid "It cannot be copied"
msgstr "Nie można skopiować"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:641
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "Pominięto %d plik ze znakiem nowego wiersza w nazwie. Nie można go bezpiecznie obsłużyć."
msgstr[1] "Pominięto %d pliki ze znakiem nowego wiersza w nazwach. Nie można ich bezpiecznie obsłużyć."
msgstr[2] "Pominięto %d plików ze znakiem nowego wiersza w nazwach. Nie można ich bezpiecznie obsłużyć."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:667
msgid "It cannot be saved here"
msgstr "Nie można tutaj zapisać"

#: locale/templates/big-storage-rescue-notifier.desktop.in:3
msgid "Big Storage Rescue notifier"
msgstr "Powiadamianie Big Storage Rescue"

#: locale/templates/big-storage-rescue-notifier.desktop.in:4
msgid "Explains why a storage device cannot be written to"
msgstr "Wyjaśnia, dlaczego nie można zapisywać na urządzeniu pamięci masowej"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:6
msgid "Storage device"
msgstr "Urządzenie pamięci masowej"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:16
msgid "Safely remove (shows what keeps it busy)"
msgstr "Wysuń bezpiecznie (pokazuje, co zajmuje urządzenie)"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:21
msgid "Check the health of this drive"
msgstr "Sprawdź stan zdrowia tego dysku"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:26
msgid "Recover files from this drive…"
msgstr "Odzyskaj pliki z tego dysku…"

#: locale/templates/big-storage-rescue-servicemenu.desktop.in:31
msgid "Open in Big Storage Rescue"
msgstr "Otwórz w Big Storage Rescue"

#: locale/templates/org.biglinux.big-storage-rescue.desktop.in:4
msgid "Storage diagnosis and file rescue"
msgstr "Diagnostyka pamięci masowej i ratowanie plików"

#: locale/templates/org.biglinux.big-storage-rescue.desktop.in:5
msgid "Find out what is wrong with a drive, why it cannot be written to or removed, and rescue your files from it"
msgstr "Sprawdzanie, co jest nie tak z dyskiem, dlaczego nie można na nim zapisywać ani go wysunąć, oraz ratowanie z niego plików"

