msgid "Never on the same physical disk as the source. If that disk fails, both are lost."
msgstr "Nie auf demselben physischen Datenträger wie die Quelle. Fällt dieser Datenträger aus, ist beides verloren."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:791
msgid "Places on another disk"
msgstr "Orte auf einem anderen Datenträger"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:792
msgid "Looking for places…"
msgstr "Orte werden gesucht …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:795 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:668
msgid "Choose another folder…"
msgstr "Anderen Ordner wählen …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:845
msgid "No other disk is mounted. Connect one, or choose a folder."
msgstr "Kein anderer Datenträger ist eingehängt. Schließen Sie einen an oder wählen Sie einen Ordner."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:866
msgid "Checking this place…"
msgstr "Dieser Ort wird geprüft …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:872
msgid "The check could not be done."
msgstr "Die Prüfung konnte nicht durchgeführt werden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:876
msgid "Everything can be saved here."
msgstr "Alles kann hier gespeichert werden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:878
#, python-format
msgid "It can be saved here: %s free."
msgstr "Es kann hier gespeichert werden: %s frei."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:881
msgid "It cannot be saved here."
msgstr "Es kann hier nicht gespeichert werden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:938
msgid "Checking the source and the destination…"
msgstr "Quelle und Ziel werden geprüft …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:947
msgid "It cannot be started."
msgstr "Der Vorgang kann nicht gestartet werden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:967
msgid "Method"
msgstr "Methode"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:970
msgid "What"
msgstr "Was"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:973
msgid "Space it will use"
msgstr "Benötigter Speicherplatz"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:975 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:977
msgid "To copy"
msgstr "Zu kopieren"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:975
#, python-format
msgid "%(files)s files, %(size)s"
msgstr "%(files)s Dateien, %(size)s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:979
msgid "Free at the destination"
msgstr "Frei am Ziel"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:981
msgid "Already there, with different content"
msgstr "Bereits vorhanden, mit anderem Inhalt"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:984
msgid "Your files will be copied with their names. Nothing is written to the source."
msgstr "Ihre Dateien werden mit ihren Namen kopiert. Auf die Quelle wird nichts geschrieben."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:985
msgid "First a list of what exists is made. Then you choose what to copy. Nothing is written to the source."
msgstr "Zuerst wird eine Liste des Vorhandenen erstellt. Dann wählen Sie aus, was kopiert werden soll. Auf die Quelle wird nichts geschrieben."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:986
msgid "Files will be searched for by their content. Names and folders are lost, some files may come out incomplete, and finding nothing is possible. Nothing is written to the source."
msgstr "Dateien werden anhand ihres Inhalts gesucht. Namen und Ordner gehen verloren, manche Dateien sind möglicherweise unvollständig, und es ist möglich, dass nichts gefunden wird. Auf die Quelle wird nichts geschrieben."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:987
msgid "The disk is read once, into a file. Nothing is written to it."
msgstr "Der Datenträger wird einmal in eine Datei gelesen. Darauf wird nichts geschrieben."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:992
msgid "After the image, the search needs your confirmation. It can also be started later."
msgstr "Nach dem Abbild benötigt die Suche Ihre Bestätigung. Sie kann auch später gestartet werden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:994
msgid "Good to know"
msgstr "Gut zu wissen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1004
#, python-format
msgid "%d item you marked"
msgid_plural "%d items you marked"
msgstr[0] "%d von Ihnen markiertes Element"
msgstr[1] "%d von Ihnen markierte Elemente"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1014
msgid "If a file already exists"
msgstr "Wenn eine Datei bereits existiert"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1019
msgid "Check the result"
msgstr "Ergebnis prüfen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Einfach: rsync bestätigt jede Datei beim Kopieren"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1021
msgid "Names, sizes and dates compared at the end"
msgstr "Namen, Größen und Datumsangaben werden am Ende verglichen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1022
msgid "Content compared at the end (reads the source again)"
msgstr "Inhalt wird am Ende verglichen (liest die Quelle erneut)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1026
msgid "Set aside a stuck file after (seconds)"
msgstr "Hängende Datei zurückstellen nach (Sekunden)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1028
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "Eine Datei, bei der es so lange nicht vorangeht, wird zurückgestellt, damit die anderen zuerst gesichert werden. 0: nie."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1032
msgid "Limit the reading speed (kB/s)"
msgstr "Lesegeschwindigkeit begrenzen (kB/s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1034
msgid "0: no limit"
msgstr "0: keine Begrenzung"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1045
msgid "Starting…"
msgstr "Wird gestartet …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1084
msgid "Read the partition table"
msgstr "Partitionstabelle lesen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1085
msgid "Analyze the whole disk"
msgstr "Gesamten Datenträger analysieren"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1086
msgid "It reads all of the disk. On a drive with problems this is extra wear."
msgstr "Der gesamte Datenträger wird gelesen. Auf einem Laufwerk mit Problemen bedeutet das zusätzlichen Verschleiß."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1089
msgid "This drive reported problems: analyzing all of it is extra wear. A disk image first spares it."
msgstr "Dieses Laufwerk hat Probleme gemeldet: Es vollständig zu analysieren, bedeutet zusätzlichen Verschleiß. Ein vorheriges Datenträgerabbild schont es."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1111
msgid "Stopping…"
msgstr "Wird angehalten …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1118
msgid "Volumes this drive already has"
msgstr "Bereits vorhandene Datenträger dieses Laufwerks"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1119
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "Sie sind nicht verloren. Um ihre Dateien wiederherzustellen, ist Kopieren schneller und liest den Datenträger weniger als jede Analyse."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1124
msgid "Recover its files"
msgstr "Dateien wiederherstellen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1136
msgid "Looking for partitions…"
msgstr "Partitionen werden gesucht …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1140
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "TestDisk meldet nicht, wie weit es ist, daher gibt es keine Prozentangabe. Die Analyse eines ganzen Datenträgers liest ihn vollständig und kann Stunden dauern; das Laufwerk kann währenddessen für nichts anderes verwendet werden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1151
#, python-format
msgid "Elapsed: %s"
msgstr "Verstrichen: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1171
msgid "The search failed."
msgstr "Die Suche ist fehlgeschlagen."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1174
msgid "What TestDisk found"
msgstr "Was TestDisk gefunden hat"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1180
msgid "Big Storage Rescue does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "Big Storage Rescue schreibt Partitionstabellen absichtlich nicht neu: Ein Fehler dort kann alles vernichten. Ein Datenträgerabbild oder eine Suche nach Inhalt stellt Dateien ohne dieses Risiko wieder her."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1182
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "Die Analyse hat keine Partition erkannt. Das beweist nicht, dass keine Daten vorhanden sind: Eine Suche nach Inhalt kann trotzdem Dateien finden."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/rescue.py:1184
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "Die Partitionstabelle ist leer oder unlesbar. Eine Analyse des gesamten Datenträgers kann finden, was sie nicht mehr aufführt."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:256
msgid "This picture cannot be shown"
msgstr "Dieses Bild kann nicht angezeigt werden"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:257
msgid "It may be incomplete. That is common with files found by content."
msgstr "Es ist möglicherweise unvollständig. Das kommt bei nach Inhalt gefundenen Dateien häufig vor."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:302 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:303
msgid "Search by name"
msgstr "Nach Name suchen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "As found"
msgstr "Fundreihenfolge"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "Largest first"
msgstr "Größte zuerst"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:305
msgid "By name"
msgstr "Nach Name"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:306
msgid "Order"
msgstr "Sortierung"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:320
msgid "Name"
msgstr "Name"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:324
msgid "Date"
msgstr "Datum"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:329
msgid "Reading the list…"
msgstr "Liste wird gelesen …"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:331
msgid "Nothing to show"
msgstr "Nichts anzuzeigen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:332
msgid "No file matches what you asked for."
msgstr "Keine Datei entspricht Ihrer Anfrage."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:339
msgid "Recover selected"
msgstr "Auswahl wiederherstellen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:341
msgid "Select all shown"
msgstr "Alle angezeigten auswählen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:342
msgid "Clear selection"
msgstr "Auswahl aufheben"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:349 big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:680
msgid "Save report"
msgstr "Bericht speichern"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:350
msgid "Try another method"
msgstr "Andere Methode versuchen"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:386
msgid "Candidates found by content. They are saved in the destination folder, without their names and folders, and some may be incomplete. Check them before deleting anything."
msgstr "Nach Inhalt gefundene Kandidaten. Sie werden im Zielordner gespeichert, ohne ihre Namen und Ordner, und einige sind möglicherweise unvollständig. Prüfen Sie sie, bevor Sie etwas löschen."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:388
#, python-format
msgid "By their structure: %(whole)d look whole, %(short)d are cut short, %(bad)d are damaged and %(other)d could not be checked. Whole does not prove every byte is right: open the files that matter."
msgstr "Nach ihrer Struktur: %(whole)d sind anscheinend vollständig, %(short)d sind abgeschnitten, %(bad)d sind beschädigt und %(other)d konnten nicht geprüft werden. Vollständig beweist nicht, dass jedes Byte stimmt: Öffnen Sie die wichtigen Dateien."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:391
msgid "Copy selected to another folder"
msgstr "Auswahl in einen anderen Ordner kopieren"

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:393
msgid "These files exist on the volume and have not been copied yet. Deleted files are not on this list."
msgstr "Diese Dateien existieren auf dem Datenträger und wurden noch nicht kopiert. Gelöschte Dateien sind nicht in dieser Liste."

#: big-storage-rescue/usr/lib/big-storage-rescue/gui/pages/results.py:406
#, python-format
